                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; text-align:right; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><apex:outputText value="{0,number,#,##0.##}"><apex:param value="{!rl.rampAdditionalQty}"/></apex:outputText></td>
                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><apex:outputText escape="false" value="{!rl.UnitHtml}"/></td>
                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; text-align:right; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;">{!currencySymbol}&nbsp;<apex:outputText value="{!moneyPattern}"><apex:param value="{!rl.UnitPrice}"/></apex:outputText></td>
                        <apex:repeat value="{!discountCol}" var="dc"><td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; text-align:right; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><apex:outputText rendered="{!rl.Discount != null}" value="{0,number,#,##0}%"><apex:param value="{!rl.Discount}"/></apex:outputText></td></apex:repeat>
                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; text-align:right; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;">{!currencySymbol}&nbsp;<apex:outputText value="{!moneyPattern}"><apex:param value="{!rl.TotalPrice}"/></apex:outputText></td>
                        <apex:repeat value="{!serviceIdCol}" var="sc">
                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><apex:outputText escape="false" value="{!assetNameHtmlByLineId[rl.line.Id]}"/></td>
                        </apex:repeat>
                        <td style="padding:3.5pt 5pt; border-bottom:0.5pt solid #e5e7eb; vertical-align:top; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><apex:outputText escape="false" value="{!rl.NotesHtml}"/></td>
                    </tr>
                </apex:repeat>
                <tr>
                    <td colspan="{!6 + IF(hasAnyDiscount,1,0)}" style="text-align:right; padding:3pt 5pt; background-color:#fef9f3; border-top:0.5pt solid #e5c4a8; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><b>{!pdfLabels['Total_Subtotal_MRC']}</b></td>
                    <td style="text-align:right; padding:3pt 5pt; background-color:#fef9f3; border-top:0.5pt solid #e5c4a8; font-size:8pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><b>{!currencySymbol}&nbsp;<apex:outputText value="{!moneyPattern}"><apex:param value="{!phase.subtotalMRC}"/></apex:outputText></b></td>
                    <td colspan="{!1 + IF(isChangeOrder,1,0)}" style="background-color:#fef9f3; border-top:0.5pt solid #e5c4a8; padding:3pt 5pt;"></td>
                </tr>
            </apex:outputPanel>
        </apex:repeat>
    </table>
</div>
</apex:outputPanel>

<!-- ═══ TERMS AND CONDITIONS ═══ -->
<apex:outputPanel rendered="{!NOT(ISBLANK(q.Service_Order_Terms__c))}">
    <p style="margin:7mm 0 4pt 0; padding:0; font-size:9pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><b>{!termsHeading}</b></p>
    <div class="terms-content" style="margin:0; padding:0; font-size:8pt; color:#000000; line-height:1.6; font-family:Arial Unicode MS, Helvetica, sans-serif;"><apex:outputText value="{!termsContent}" escape="false"/></div>
</apex:outputPanel>

<!-- ═══ SPECIAL NOTE ═══ -->
<apex:outputPanel rendered="{!showSpecialNote}">
    <p style="margin:5mm 0 4pt 0; padding:0; font-size:9pt; font-family:Arial Unicode MS, Helvetica, sans-serif; color:#000000;"><b><i>{!pdfLabels['Heading_Special_Note']}</i></b></p>
    <div style="margin:0; padding:0; font-size:8pt; color:#000000; line-height:1.6; font-family:Arial Unicode MS, Helvetica, sans-serif; white-space:pre-line;"><apex:outputText value="{!specialNote}" escape="false"/></div>
</apex:outputPanel>

<!-- ═══ SIGNATURE BLOCK ═══ -->
<apex:outputPanel rendered="{!q != null && q.Is_Binding__c == true}">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-top:8mm; border-collapse:collapse;">
        <tr>
            <td width="50%" style="vertical-align:top; padding:2pt 8mm 2pt 0;">
                <b style="font-size:8.5pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif;">{!quoteAccountName}</b>
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-top:6mm;">
                    <tr>
                        <td width="35%" style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Authorized_Signatory']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                    <tr>
                        <td style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Name']} / {!pdfLabels['Signature_Title']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                    <tr>
                        <td style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Date']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                </table>
            </td>
            <td width="50%" style="vertical-align:top; padding:2pt 0 2pt 8mm;">
                <b style="font-size:8.5pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif;">{!deEntityName}</b>
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-top:6mm;">
                    <tr>
                        <td width="35%" style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Authorized_Signatory']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                    <tr>
                        <td style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Name']} / {!pdfLabels['Signature_Title']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                    <tr>
                        <td style="font-size:7pt; color:#000000; font-family:Arial Unicode MS, Helvetica, sans-serif; vertical-align:bottom; white-space:nowrap; padding:8mm 6pt 1pt 0;">{!pdfLabels['Signature_Date']}</td>
                        <td style="border-bottom:0.5pt solid #9ca3af; vertical-align:bottom; padding-top:8mm;">&#160;</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</apex:outputPanel>


</body>
</html>
</apex:page>