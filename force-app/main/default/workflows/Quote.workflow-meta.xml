<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Send_opportunity_owner_a_notification_when_quote_is_approved</fullName>
        <description>Send opportunity owner a notification when quote is approved</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderAddress>portal@digitaledgedc.com</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/DE_Quote_Approved_Notification</template>
    </alerts>
    <fieldUpdates>
        <fullName>Quote_CreditFinanceApproved</fullName>
        <description>Set Credit Finance Approved to TRUE when Credit Limit approval is granted.</description>
        <field>Credit_Finance_Approved__c</field>
        <literalValue>1</literalValue>
        <name>Quote Credit Finance Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SBI_Approved</fullName>
        <description>Set SBI Finance Approved to TRUE when SBI approval is granted.</description>
        <field>SBI_Finance_Approved__c</field>
        <literalValue>1</literalValue>
        <name>Quote SBI Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SBI_FlagReset</fullName>
        <description>Reset SBI Flag to FALSE after SBI approval completes, so the next Billing Mode change to Arrears triggers a new SBI approval.</description>
        <field>SBI_Flag__c</field>
        <literalValue>0</literalValue>
        <name>Quote SBI Flag Reset</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SetApprovedOnApproval</fullName>
        <description>Set Quote Status to Approved when the approval request is approved.</description>
        <field>Status</field>
        <literalValue>Approved</literalValue>
        <name>Quote Set Approved On Approval</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SetBindingOnApproval</fullName>
        <description>Set Is_Binding__c to TRUE when the quote review approval is granted. Ensures binding status is only achieved through the approval path.</description>
        <field>Is_Binding__c</field>
        <literalValue>1</literalValue>
        <name>Quote Set Binding On Approval</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SetDraftOnRejection</fullName>
        <description>Revert Quote Status to Draft when the approval request is rejected or recalled.</description>
        <field>Status</field>
        <literalValue>Draft</literalValue>
        <name>Quote Set Draft On Rejection</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SetFinanceApproved</fullName>
        <description>Set Finance Approval Status to Approved when the quote approval is granted.</description>
        <field>Finance_Approval_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Quote Set Finance Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_SetInReviewOnSubmit</fullName>
        <description>Set Quote Status to In Review when submitted for approval.</description>
        <field>Status</field>
        <literalValue>In Review</literalValue>
        <name>Quote Set In Review On Submit</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
</Workflow>
