<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DE_Lead_Disqualification_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status, &apos;Disqualified&apos;), ISBLANK(TEXT(Disqualification_Reason__c)))</errorConditionFormula>
    <errorDisplayField>Disqualification_Reason__c</errorDisplayField>
    <errorMessage>Disqualification Reason is required when Status = Disqualified.</errorMessage>
</ValidationRule>
