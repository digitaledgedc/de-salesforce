<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_OPP_05_Contract_Term_Minimum</fullName>
    <active>true</active>
    <description>VR-OPP-05: Minimum contract term is 1 months. Deactivate during data migration for legacy deals.</description>
    <errorConditionFormula>AND( NOT(ISBLANK(Contract_Term_Months__c)), Contract_Term_Months__c &gt; 0, Contract_Term_Months__c &lt; 1 )</errorConditionFormula>
    <errorDisplayField>Contract_Term_Months__c</errorDisplayField>
    <errorMessage>Minimum contract term is 1 month.</errorMessage>
</ValidationRule>
