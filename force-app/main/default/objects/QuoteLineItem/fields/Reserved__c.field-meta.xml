<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reserved__c</fullName>
    <description>Indicates whether inventory has been reserved for this quote line. Set automatically when a space is assigned via the Capacity Reserve component.</description>
    <inlineHelpText>Whether inventory space has been reserved for this line item.</inlineHelpText>
    <label>Reserved</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Not Reserved</fullName>
                <default>true</default>
                <label>Not Reserved</label>
            </value>
            <value>
                <fullName>Reserved</fullName>
                <default>false</default>
                <label>Reserved</label>
            </value>
            <value>
                <fullName>N/A</fullName>
                <default>false</default>
                <label>N/A</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
