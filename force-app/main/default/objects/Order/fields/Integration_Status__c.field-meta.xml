<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Integration_Status__c</fullName>
    <inlineHelpText>Tracks whether this order has been sent to and acknowledged by Odoo. Failed - Manual Review Required means the Odoo team needs to investigate. Populated automatically by the integration.</inlineHelpText>
    <label>Odoo Sync Status</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>false</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending</fullName>
                <default>false</default>
                <label>Pending</label>
            </value>
            <value>
                <fullName>Sent</fullName>
                <default>false</default>
                <label>Sent</label>
            </value>
            <value>
                <fullName>Acknowledged</fullName>
                <default>false</default>
                <label>Acknowledged</label>
            </value>
            <value>
                <fullName>Failed_Manual_Review_Required</fullName>
                <default>false</default>
                <label>Failed - Manual Review Required</label>
            </value>
            <value>
                <fullName>Failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>Synced</fullName>
                <default>false</default>
                <label>Synced</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
