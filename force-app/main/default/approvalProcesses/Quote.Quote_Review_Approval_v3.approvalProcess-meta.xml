<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Status</field>
        <field>Total_MRC_2__c</field>
        <field>Total_NRC__c</field>
        <field>Total_Contract_Value_2__c</field>
        <field>Target_Site__c</field>
        <field>DE_Entity__c</field>
        <field>Feasibility_Status__c</field>
        <field>Feasibility_Notes__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Country_Manager__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Country Manager Review</label>
        <name>Country_Manager_Review</name>
        <rejectionActions>
            <action>
                <name>Quote_SetDraftOnRejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Capacity_Manager__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Capacity Manager Review</label>
        <name>Capacity_Manager_Review</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Quote_SetDraftOnRejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Two-step quote review approval. Step 1: Capacity Manager reviews. Step 2: Country Manager reviews. On final approval, status moves to Approved. On rejection at step 2, it returns to Capacity Manager. On rejection at step 1, status reverts to Draft.</description>
    <emailTemplate>unfiled$public/DE_Quote_Approval_Notification</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Quote.Status</field>
            <operation>equals</operation>
            <value>Draft</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Quote_SBI_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_SetApprovedOnApproval</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Quote_SetFinanceApproved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Quote_SetDraftOnRejection</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Quote_SetInReviewOnSubmit</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Quote Review Approval v3</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>Quote_SetDraftOnRejection</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
