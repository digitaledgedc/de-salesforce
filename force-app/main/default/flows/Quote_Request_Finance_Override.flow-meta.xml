            </value>
        </filters>
        <object>Account</object>
        <outputReference>var_account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Credit_Block_Reason__c</queriedFields>
    </recordLookups>
    <recordLookups>
