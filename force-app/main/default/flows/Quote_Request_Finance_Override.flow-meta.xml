<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notify_Finance_CreditAdjust</name>
        <label>Notify Finance - Credit Adjust Request</label>
        <locationX>374</locationX>
        <locationY>720</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Screen_AdjustConfirmation</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>finance-approvals@digitaledge.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>frmAdjustSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>frmAdjustBody</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Notify_Finance_Override</name>
        <label>Notify Finance - Override Request</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Screen_OverrideConfirmation</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>finance-approvals@digitaledge.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>frmOverrideSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>frmOverrideBody</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>ch_CreditAdjust</name>
        <choiceText>Request Credit Limit Adjustment - permanent increase to this account approved MRC and NRC credit limits. Finance reviews and updates the account limits.</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>CreditAdjust</stringValue>
        </value>
    </choices>
    <choices>
        <name>ch_Override</name>
        <choiceText>Request Override - one-time exception for this Quote only. Does not change the account credit limit. Finance approves this specific deal.</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Override</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Is_Credit_Adjust</name>
        <label>Credit Adjust or Override?</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Notify_Finance_Override</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Override</defaultConnectorLabel>
        <rules>
            <name>Credit_Adjust_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inp_overrideType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CreditAdjust</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_CreditAdjustDetails</targetReference>
            </connector>
            <label>Credit Adjust Selected</label>
        </rules>
    </decisions>
    <description>F-COR: Launched from the Request Finance Override quick action on a blocked Quote. Lets the user choose Override (one-time exception) or Credit Adjust (permanent credit limit change). Reads credit block info from the Account and notifies Finance by email. Credit block fields removed from Quote - now references Account directly.</description>
    <formulas>
        <name>frmAdjustBody</name>
        <dataType>String</dataType>
        <expression>&quot;A permanent Credit Limit Adjustment has been requested for Quote: &quot; &amp; {!var_quote.Name} &amp; &quot;\n\nRequested MRC Limit: &quot; &amp; TEXT({!inp_newMRC}) &amp; &quot;\nRequested NRC Limit: &quot; &amp; TEXT({!inp_newNRC}) &amp; &quot;\n\nRequested by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot;\n\nPlease review and update the account credit limits in Salesforce if approved.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmAdjustSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Credit Limit Adjustment Requested for Quote: &quot; &amp; {!var_quote.Name}</expression>
    </formulas>
    <formulas>
        <name>frmOverrideBody</name>
        <dataType>String</dataType>
        <expression>&quot;A one-time Credit Override has been requested for:\n\nQuote: &quot; &amp; {!var_quote.Name} &amp; &quot;\nBlock Reason: &quot; &amp; TEXT({!var_account.Credit_Block_Reason__c}) &amp; &quot;\n\nRequested by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot;\n\nThis is a one-time exception for this Quote only and does not change the account credit limit. Please review and approve in Salesforce.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmOverrideSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Credit Override Requested: &quot; &amp; {!var_quote.Name}</expression>
    </formulas>
    <interviewLabel>Quote - Request Finance Override {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Request Finance Override</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account Credit Info</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
