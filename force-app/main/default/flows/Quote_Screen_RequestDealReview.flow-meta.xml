<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Invoked from the Request Deal Review quick action on the Quote record. Looks up the linked Opportunity and sets DR_Status__c = DR Required, DR_Required__c = true, DR_Requested_Date__c = today. Mirrors F-12 (Opportunity_Screen_RequestDealReview) but invoked from the Quote context.</description>
    <interviewLabel>Quote Screen Request Deal Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Screen - Request Deal Review</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>getQuote</name>
        <label>Get Quote Opportunity ID</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>updateOpportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Quote</object>
        <outputAssignments>
            <assignToReference>varOpportunityId</assignToReference>
            <field>OpportunityId</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>updateOpportunity</name>
        <label>Set DR Status on Opportunity</label>
        <locationX>176</locationX>
        <locationY>372</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOpportunityId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>DR_Requested_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DR_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DR_Status__c</field>
            <value>
                <stringValue>DR Required</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Screen_Confirm</name>
        <label>Request Deal Review</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>getQuote</targetReference>
        </connector>
        <fields>
            <name>Display_Instructions</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Submit this Quote for Deal Review.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Submitting will flag the linked Opportunity as &quot;DR Required&quot;. Management will be notified to review before this quote proceeds. Click &lt;b&gt;Finish&lt;/b&gt; to confirm.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varOpportunityId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
