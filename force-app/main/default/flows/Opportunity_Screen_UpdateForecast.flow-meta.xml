<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>ch_BestCase</name>
        <choiceText>Best Case</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Best Case</stringValue>
        </value>
    </choices>
    <choices>
        <name>ch_Commit</name>
        <choiceText>Commit</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Commit</stringValue>
        </value>
    </choices>
    <choices>
        <name>ch_Pipeline</name>
        <choiceText>Pipeline</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Pipeline</stringValue>
        </value>
    </choices>
    <description>OPP-004: Screen flow for standalone forecast category update, independent from stage changes. Available at Stages 2-4 via Dynamic Actions. Allows reps to update Forecast Category to Pipeline, Best Case, or Commit without changing the stage.</description>
    <interviewLabel>Opportunity Screen Update Forecast {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Screen - Update Forecast</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_UpdateForecast</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>StageName</queriedFields>
        <queriedFields>ForecastCategoryName</queriedFields>
        <queriedFields>Amount</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Forecast</name>
        <label>Set Forecast Category</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ForecastCategoryName</field>
            <value>
                <elementReference>inp_ForecastCategory</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Screen_UpdateForecast</name>
        <label>Update Forecast Category</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Forecast</targetReference>
        </connector>
        <fields>
            <name>Display_CurrentForecast</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Update Forecast Category&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Current stage: &lt;b&gt;{!Get_Opportunity.StageName}&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Current forecast: &lt;b&gt;{!Get_Opportunity.ForecastCategoryName}&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Select the new forecast category. This does not change the opportunity stage.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_ForecastCategory</name>
            <choiceReferences>ch_Pipeline</choiceReferences>
            <choiceReferences>ch_BestCase</choiceReferences>
            <choiceReferences>ch_Commit</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Forecast Category</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
