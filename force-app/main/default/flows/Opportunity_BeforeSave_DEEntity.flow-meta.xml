<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_DE_Entity</name>
        <label>Set DE Entity from Site</label>
        <locationX>374</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.DE_Entity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_SiteDeEntity</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Clear_DE_Entity</name>
        <label>Clear DE Entity</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>$Record.DE_Entity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_Has_Site</name>
        <label>Has Target Site?</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Clear_DE_Entity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Site</defaultConnectorLabel>
        <rules>
            <name>Outcome_Has_Site</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Target_Site__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_DE_Entity</targetReference>
            </connector>
            <label>Has Site</label>
        </rules>
    </decisions>
    <description>F-37: Auto-populates Opportunity.DE_Entity__c from Site__c.DE_Entity__c whenever Target_Site__c is set or changed. Clears DE_Entity when Target_Site is removed.</description>
    <formulas>
        <name>formula_SiteDeEntity</name>
        <dataType>String</dataType>
        <expression>{!$Record.Target_Site__r.DE_Entity__c}</expression>
    </formulas>
    <label>Opportunity - Before Save - DE Entity</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Has_Site</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Target_Site__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
