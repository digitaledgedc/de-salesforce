    <description>F-MDC: Allows authorised users to request a change to locked legal entity fields on an Account after Finance Approval. Captures the field to change, the new value, and the business reason. Creates a Task on the Account with all request details and notifies Finance via email. Does not directly change any field - Finance makes the change after approval.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmBody</name>
        <dataType>String</dataType>
        <expression>&quot;A Master Data Change has been requested for Account: &quot; &amp; {!var_account.Name} &amp; &quot;\n\nField: &quot; &amp; {!inp_fieldToChange} &amp; &quot;\nRequested New Value: &quot; &amp; {!inp_newValue} &amp; &quot;\nBusiness Reason: &quot; &amp; {!inp_reason} &amp; &quot;\n\nRequested by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; (&quot; &amp; {!$User.Email} &amp; &quot;)\n\nPlease review and make the change directly in Salesforce if approved.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmLineBreak</name>
        <dataType>String</dataType>
        <expression>BR()</expression>
    </formulas>
    <formulas>
        <name>frmSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Master Data Change Request: &quot; &amp; {!var_account.Name} &amp; &quot; - &quot; &amp; {!inp_fieldToChange}</expression>
    </formulas>
    <formulas>
        <name>frmTaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Account: &quot; &amp; {!var_account.Name} &amp;
BR() &amp; &quot;Field to Change: &quot; &amp; {!inp_fieldToChange} &amp;
{!frmLineBreak} &amp; &quot;Requested New Value: &quot; &amp; {!inp_newValue} &amp;
BR() &amp; &quot;Business Reason: &quot; &amp; {!inp_reason} &amp;
BR() &amp; BR() &amp; &quot;Requested by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; (&quot; &amp; {!$User.Email} &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>Account - Request Master Data Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Screen - Request Master Data Change</label>
