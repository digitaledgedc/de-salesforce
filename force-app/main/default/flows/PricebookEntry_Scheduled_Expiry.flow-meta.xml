<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Inactive</name>
        <label>Set IsActive to False</label>
        <locationX>264</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>Loop_Expired_Entries.IsActive</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>col_toUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Expired_Entries</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Expired_Entries</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_Expired_Entries</name>
        <label>Any Expired Entries?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No expired entries - no action</defaultConnectorLabel>
        <rules>
            <name>Entries_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_expiredEntries</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Expired_Entries</targetReference>
            </connector>
            <label>Entries Found</label>
        </rules>
    </decisions>
    <description>H-30: Daily scheduled flow. Queries active PricebookEntry records where Effective_To__c is in the past. Deactivates them by setting IsActive = false. Runs at 05:00 UTC daily.</description>
    <formulas>
        <name>frmDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>frmToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>PricebookEntry Expiry Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PricebookEntry - Scheduled - Expiry</label>
    <loops>
        <name>Loop_Expired_Entries</name>
        <label>Loop Expired Entries</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>col_expiredEntries</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Inactive</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Expired_Entries</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Expiry_Task</name>
        <label>Create Expiry Notification Task</label>
        <locationX>176</locationX>
        <locationY>840</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>frmDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>The nightly pricebook expiry job deactivated one or more PricebookEntry records whose Effective To date has passed. Review the affected entries and update pricing if replacement entries are needed.

Use the PricebookEntry list view filtered by &quot;IsActive equals false&quot; and &quot;Effective To less than today&quot; to find all recently expired entries.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_RevOps_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Pricebook Entries Expired and Deactivated</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Expired_Entries</name>
        <label>Get Expired PricebookEntries</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Expired_Entries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Effective_To__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>frmToday</elementReference>
            </value>
        </filters>
        <object>PricebookEntry</object>
        <outputReference>col_expiredEntries</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>IsActive</queriedFields>
        <queriedFields>Effective_To__c</queriedFields>
        <queriedFields>Product2Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_RevOps_Queue</name>
        <label>Get Revenue Operations Queue</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Expiry_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DE_Revenue_Operations</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Expired_Entries</name>
        <label>Update Expired Entries</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Get_RevOps_Queue</targetReference>
        </connector>
        <inputReference>col_toUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Expired_Entries</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-05-18</startDate>
            <startTime>05:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_expiredEntries</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>col_toUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
</Flow>
