    <description>F-UploadDocument: Reusable screen flow for uploading documents to any Salesforce record. Accepts a recordId and optional context (object type) as inputs. Presents a document type picker and a file upload component.</description>
    <interviewLabel>Upload Document {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Upload Document</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Screen_Success</name>
        <label>Upload Complete</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
