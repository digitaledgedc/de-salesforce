<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Negative_Qty</name>
        <label>Set Qty to -1</label>
        <locationX>50</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>$Record.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>-1.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Termination</name>
        <label>Is Termination Quote?</label>
        <locationX>176</locationX>
        <locationY>372</locationY>
        <defaultConnectorLabel>Not Termination</defaultConnectorLabel>
        <rules>
            <name>Is_Termination</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Parent_Quote.Quote_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Termination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Quote.Amendment_Reason__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Termination</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Negative_Qty</targetReference>
            </connector>
            <label>Termination</label>
        </rules>
    </decisions>
    <description>Before-save flow on QuoteLineItem. When the parent Quote is a termination (Quote_Type__c = Termination OR Amendment_Reason__c = Termination), forces Quantity to -1 so the Grand Total is negative and Odoo integration interprets lines as service removals.</description>
    <environments>Default</environments>
    <interviewLabel>QLI Termination Qty {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QuoteLineItem Before-Save Termination Qty</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Parent_Quote</name>
        <label>Get Parent Quote</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Termination</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quote_Type__c</queriedFields>
        <queriedFields>Amendment_Reason__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Parent_Quote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Quantity</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>-1.0</numberValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
