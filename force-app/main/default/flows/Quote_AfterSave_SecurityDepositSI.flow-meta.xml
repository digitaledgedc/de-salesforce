<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Creates a Special_Instruction__c record with Type = Security Deposit Required when Quote.Security_Deposit_Required__c is checked.</description>
    <formulas>
        <name>frmCountry</name>
        <dataType>String</dataType>
        <expression>TEXT({!var_account.Operation_Country__c})</expression>
    </formulas>
    <formulas>
        <name>frmDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Security deposit required. &quot; &amp; IF(ISBLANK({!$Record.Security_Deposit_Notes__c}), &quot;&quot;, &quot;Notes: &quot; &amp; {!$Record.Security_Deposit_Notes__c})</expression>
    </formulas>
    <formulas>
        <name>frmFinanceQueueDevName</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!var_account.Operation_Country__c}),
&quot;Japan&quot;, &quot;DE_JP_Country_Finance&quot;,
&quot;South Korea&quot;, &quot;DE_KR_Country_Finance&quot;,
&quot;Indonesia&quot;, &quot;DE_ID_Country_Finance&quot;,
&quot;Philippines&quot;, &quot;DE_PH_Country_Finance&quot;,
&quot;China&quot;, &quot;DE_CN_Country_Finance&quot;,
&quot;India&quot;, &quot;DE_IN_Country_Finance&quot;,
&quot;Thailand&quot;, &quot;DE_TH_Country_Finance&quot;,
&quot;Malaysia&quot;, &quot;DE_MY_Country_Finance&quot;,
&quot;Singapore&quot;, &quot;DE_SG_Country_Finance&quot;,
&quot;Hong Kong&quot;, &quot;DE_HK_Country_Finance&quot;,
&quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!var_financeQueue.Id}), {!$User.Id}, {!var_financeQueue.Id})</expression>
    </formulas>
    <interviewLabel>Quote Security Deposit SI {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - After Save - Security Deposit SI</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_SI</name>
        <label>Create Special Instruction</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Country__c</field>
            <value>
                <elementReference>frmCountry</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <elementReference>frmDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>frmOwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quote__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type__c</field>
            <value>
                <stringValue>Security Deposit Required</stringValue>
            </value>
        </inputAssignments>
        <object>Special_Instruction__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Finance_Queue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>var_account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Operation_Country__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Finance_Queue</name>
        <label>Get Finance Queue</label>
        <locationX>176</locationX>
        <locationY>432</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_SI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmFinanceQueueDevName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <object>Group</object>
        <outputReference>var_financeQueue</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Security_Deposit_Required__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Security_Deposit_Required__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>var_account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>var_financeQueue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Group</objectType>
    </variables>
</Flow>
