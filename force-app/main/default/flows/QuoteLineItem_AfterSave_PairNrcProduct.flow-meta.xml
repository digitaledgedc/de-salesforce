<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>pairNrcProduct</name>
        <label>Pair NRC Product</label>
        <locationX>308</locationX>
        <locationY>276</locationY>
        <actionName>NrcPairingService</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>qliIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>NrcPairingService</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When a recurring charge (.RC) QuoteLineItem is created, calls NrcPairingService to automatically add the matching non-recurring installation charge (.NR) QLI if one does not already exist on the Quote. Fires async to keep the MRC insert transaction clean. Scoped to .RC product codes only - .NR products are intentionally excluded to prevent recursion.</description>
    <environments>Default</environments>
    <label>QuoteLineItem After Save Pair NRC Product</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Charge_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MRC</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Auto_NRC__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Change_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>DELETE</stringValue>
            </value>
        </filters>
        <filters>
            <field>Change_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>CHANGE</stringValue>
            </value>
        </filters>
        <filters>
            <field>Change_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>CHANGE_PRICE</stringValue>
            </value>
        </filters>
        <filters>
            <field>Change_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>NO_CHANGE</stringValue>
            </value>
        </filters>
        <filters>
            <field>Change_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>RENEW</stringValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>pairNrcProduct</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
