<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Submit_For_Approval</name>
        <label>Submit for Country Manager Approval</label>
        <locationX>770</locationX>
        <locationY>720</locationY>
        <actionName>OrderApprovalService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>orderId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>comments</name>
            <value>
                <elementReference>inp_Comments</elementReference>
            </value>
        </inputParameters>
        <nameSegment>OrderApprovalService</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_CountryManagerSet</name>
        <label>Country Manager Set?</label>
        <locationX>374</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Screen_NoCountryManager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Set - Block</defaultConnectorLabel>
        <rules>
            <name>CountryManager_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order.Country_Manager__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_SubmitDetails</targetReference>
            </connector>
            <label>Country Manager Set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_UserConfirmed</name>
        <label>User Confirmed?</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Screen_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Confirmed - Exit</defaultConnectorLabel>
        <rules>
            <name>Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>chk_Confirm</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_PendingApproval</targetReference>
            </connector>
            <label>Confirmed</label>
        </rules>
    </decisions>
    <description>Screen flow launched from the Submit For Approval quick action on Order. Validates that Country_Manager__c is set, collects submission comments, sets Status to Pending Approval, then submits to the Order_Country_Manager_Approval process. Country Manager must be set on the Order before launching this flow.</description>
    <interviewLabel>Order Submit For Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order - Screen - Submit For Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Order</name>
        <label>Get Order</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_CountryManagerSet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>OrderNumber</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Country_Manager__c</queriedFields>
        <queriedFields>Total_MRC__c</queriedFields>
        <queriedFields>Total_NRC__c</queriedFields>
        <queriedFields>Operation_Site__c</queriedFields>
        <queriedFields>Order_Type__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Order_PendingApproval</name>
        <label>Set Status to Pending Approval</label>
        <locationX>770</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Submit_For_Approval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Pending Approval</stringValue>
            </value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
