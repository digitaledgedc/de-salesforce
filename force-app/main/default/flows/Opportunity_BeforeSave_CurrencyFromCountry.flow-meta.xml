    <decisions>
        <name>BAN_Currency_Found</name>
        <label>Account has an active BAN with a currency?</label>
        <locationX>150</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Get_CountryCurrency</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No active BAN - resolve by country</defaultConnectorLabel>
        <rules>
            <name>BAN_Has_Currency</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_BAN_For_Account.BAN_Currency__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Currency_From_BAN</targetReference>
            </connector>
            <label>BAN Has Currency</label>
        </rules>
    </decisions>
    <decisions>
        <name>Currency_Is_USD</name>
        <label>Currency is USD?</label>
        <locationX>248</locationX>
        <locationY>887</locationY>
        <defaultConnector>
            <targetReference>Get_Dated_FX_Rate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Non-USD - use dated rate</defaultConnectorLabel>
        <rules>
            <name>Is_USD</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CurrencyIsoCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>USD</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_FX_Rate_USD</targetReference>
            </connector>
            <label>Is USD</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Currency_Found</name>
        <label>CMT mapping found?</label>
        <locationX>402</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Currency_Is_USD</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No mapping - check current currency</defaultConnectorLabel>
        <rules>
            <name>Mapping_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CountryCurrency.Currency_ISO_Code__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Currency</targetReference>
            </connector>
            <label>Mapping Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>FX_rate_check</name>
        <label>FX rate check</label>
        <locationX>446</locationX>
        <locationY>1103</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>FX_Rate_Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Dated_FX_Rate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_FX_Rate</targetReference>
            </connector>
            <label>FX Rate Needed?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Change_Order</name>
        <label>Is Change Order or Renewal?</label>
        <locationX>248</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Get_Active_BAN_For_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New business - resolve currency</defaultConnectorLabel>
        <rules>
            <name>Is_CO_Or_Renewal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Original_Order__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Currency_Is_USD</targetReference>
            </connector>
            <label>Is CO or Renewal</label>
        </rules>
        <rules>
            <name>Is_Ramp_Phase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Is_Ramp_Deal__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Currency_Is_USD</targetReference>
            </connector>
            <label>Is Ramp Phase</label>
        </rules>
        <rules>
            <name>Is_Existing_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Currency_Is_USD</targetReference>
            </connector>
            <label>Existing Record - Don&apos;t Re-Derive Currency</label>
        </rules>
    </decisions>
    <description>Single source of truth for Opportunity currency and FX_Rate__c. For new business (Original_Order__c blank and not a ramp phase) being CREATED, resolves CurrencyIsoCode by first checking the Account&apos;s existing active Billing Account (BillingAccount__c.BAN_Currency__c) — an existing customer&apos;s established billing currency always wins — and only falls back to Country_Currency__mdt by Operation_Country__c when the account has no active BAN yet (SFDC-569 fix, 2026-09-23: previously always defaulted by country, ignoring an already-established USD BAN for e.g. Philippines-based accounts). For Change Orders and Renewals (Original_Order__c populated), ramp phase Opportunities (Is_Ramp_Deal__c = true), and any record that already EXISTS (Is_Existing_Record — SFDC-569 fix: currency is now only ever derived on ISNEW(), never re-derived on a later update, since ISCHANGED(CurrencyIsoCode) previously made this flow silently revert a rep&apos;s manual currency correction back to the country default in the same save), currency is left untouched, but FX_Rate__c is still (re)stamped from the up-to-date DatedConversionRate as of the record&apos;s own CloseDate, rather than being left blank or carrying over a stale rate. Fires on create, and on update whenever CurrencyIsoCode or CloseDate changes, so FX_Rate__c stays current if a CO&apos;s close date moves or a rep corrects currency after the initial save. FX: whenever the record&apos;s currency is USD, FX_Rate__c is always stamped to 1 (dividing an already-USD amount by 1 leaves it unchanged); whenever it is a local currency, FX_Rate__c is always re-stamped from DatedConversionRate for the close date when a dated rate exists.</description>
    <environments>Default</environments>
    <interviewLabel>Opp Before Save Currency {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Before Save - Currency From Country</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_BAN_For_Account</name>
        <label>Get Active BAN For Account</label>
        <locationX>150</locationX>
        <locationY>330</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>BAN_Currency_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BillingAccount__c</object>
        <queriedFields>BAN_Currency__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_CountryCurrency</name>
        <label>Get Currency For Operation Country</label>
        <locationX>402</locationX>
        <locationY>395</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Currency_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Operation_Country__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Country_Currency__mdt</object>
        <queriedFields>Currency_ISO_Code__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Dated_FX_Rate</name>
        <label>Get Dated FX Rate</label>
        <locationX>446</locationX>
        <locationY>995</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>FX_rate_check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsoCode</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CurrencyIsoCode</elementReference>
            </value>
        </filters>
        <filters>
            <field>StartDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.CloseDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>NextStartDate</field>
            <operator>GreaterThan</operator>
            <value>
                <elementReference>$Record.CloseDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DatedConversionRate</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Change_Order</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK(TEXT({!$Record.Operation_Country__c}))), OR(ISNEW(), ISCHANGED({!$Record.CurrencyIsoCode})))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
