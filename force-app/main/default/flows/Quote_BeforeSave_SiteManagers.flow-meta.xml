    <decisions>
        <name>Has_Target_Site</name>
        <label>Has Target Site?</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>Clear_Managers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Site</defaultConnectorLabel>
        <rules>
            <name>Site_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Target_Site__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Site</targetReference>
            </connector>
            <label>Site Set</label>
        </rules>
    </decisions>
    <description>Before-save flow on Quote. When Target_Site__c is set or changed, copies Country_Manager__c, Capacity_Manager__c, and Finance_Country_Manager__c from the related Site record to the Quote for use in approval process routing. Also triggers when Target_Site__c is set but Finance_Country_Manager__c is null (backfill for quotes created before this flow).</description>
    <environments>Default</environments>
    <interviewLabel>Quote Site Managers {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Before-Save Site Managers</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Site</name>
        <label>Get Site</label>
        <locationX>176</locationX>
        <locationY>372</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Managers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Target_Site__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Site__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Country_Manager__c</queriedFields>
        <queriedFields>Platform_Manager__c</queriedFields>
        <queriedFields>Capacity_Manager__c</queriedFields>
        <queriedFields>Finance_Country_Manager__c</queriedFields>
        <queriedFields>Finance_Country_Queue__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Has_Target_Site</targetReference>
        </connector>
        <filterLogic>1 OR (2 AND 3)</filterLogic>
        <filters>
            <field>Target_Site__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Target_Site__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Finance_Country_Manager__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
