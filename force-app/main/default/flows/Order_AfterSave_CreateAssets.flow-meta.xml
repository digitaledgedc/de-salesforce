<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Asset_Collection</name>
        <label>Add To Asset Collection</label>
        <locationX>396</locationX>
        <locationY>482</locationY>
        <assignmentItems>
            <assignToReference>col_AssetsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_NewAsset</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_OrderItems</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Asset_Record</name>
        <label>Build Asset Record</label>
        <locationX>396</locationX>
        <locationY>374</locationY>
        <assignmentItems>
            <assignToReference>var_NewAsset.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Description</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Product2Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Product2Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Quantity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Quantity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Price</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.MRC_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.MRC__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.MRC_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Source_Order__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Source_OrderItem__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Operation_Site__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Operation_Site__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.SCD__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.ServiceDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Inventory__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Inventory__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Space__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_OrderItems.Space__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Installed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.Asset_Lifecycle_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_NewAsset.InstallDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frm_Today</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Asset_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_HasOrderItems</name>
        <label>Has MRC Order Items?</label>
        <locationX>176</locationX>
        <locationY>266</locationY>
        <defaultConnectorLabel>No Items - End</defaultConnectorLabel>
        <rules>
            <name>Has_Items</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_MRC_OrderItems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_OrderItems</targetReference>
            </connector>
            <label>Has Items</label>
        </rules>
    </decisions>
    <description>F-23: SKELETON - Asset creation is inbound from Odoo via IP-5 (OdooAssetStatusHandler). Odoo processes the confirmed Order, creates subscriptions (Assets) and subscription lines (Asset state), and POSTs them back to Salesforce. This flow is inactive pending Module 12 IP-5 implementation. Do not activate - Assets must not be created by Salesforce.</description>
    <formulas>
        <name>frm_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <label>Order After Save Create Assets</label>
    <loops>
        <name>Loop_OrderItems</name>
        <label>Loop Order Items</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <collectionReference>Get_MRC_OrderItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Asset_Record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Assets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Assets</name>
        <label>Create Assets</label>
        <locationX>176</locationX>
        <locationY>482</locationY>
        <inputReference>col_AssetsToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_MRC_OrderItems</name>
        <label>Get MRC Order Items</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_HasOrderItems</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Charge_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MRC</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product2Id</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>MRC_Amount__c</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <queriedFields>ServiceDate</queriedFields>
        <queriedFields>Inventory__c</queriedFields>
        <queriedFields>Space__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_MRC_OrderItems</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Order_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Churn</stringValue>
            </value>
        </filters>
        <filters>
            <field>Order_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Partial Churn</stringValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_AssetsToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>var_NewAsset</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
</Flow>
