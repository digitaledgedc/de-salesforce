    <description>F-03: Assigns Lead to correct queue based on Customer_Type__c and Target_Country__c. Reads queue IDs from Country_Queue__mdt - no hardcoded IDs. Before Save for fast field updates.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_RoleSalesTeam</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!Get_Running_Role.Name}, &quot;Indonesia&quot;), &quot;Indonesia&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;Malaysia&quot;), &quot;Malaysia&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;India&quot;), &quot;India&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;Japan&quot;), &quot;Japan&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;China&quot;), &quot;China&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;Korea&quot;), &quot;Korea&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;Philippines&quot;), &quot;Philippines&quot;,
IF(BEGINS({!Get_Running_Role.Name}, &quot;Thailand&quot;), &quot;Thailand&quot;,
&quot;Platform&quot;))))))))</expression>
    </formulas>
    <formulas>
        <name>formula_SalesTeamLabel</name>
        <dataType>String</dataType>
        <expression>{!Loop_For_Country_Queue.Country_Code__c}</expression>
    </formulas>
