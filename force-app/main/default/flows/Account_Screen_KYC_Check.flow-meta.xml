        <locationX>1810</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Screen_DnB_Not_Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>D&amp;B Not Done - Cannot Proceed</defaultConnectorLabel>
        <rules>
            <name>Phase_KYC_Pending_Already_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>KYC_Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_account.KYC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Credit_Decision</targetReference>
            </connector>
            <label>KYC Already Done → Credit Decision</label>
        </rules>
        <rules>
            <name>Phase_KYC_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>KYC_Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_KYC_Review</targetReference>
            </connector>
            <label>KYC Pending → KYC Review</label>
        </rules>
        <rules>
            <name>Phase_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Already_Approved</targetReference>
            </connector>
            <label>Already Approved → Terminal</label>
        </rules>
        <rules>
            <name>Phase_Rejected_DnB</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected_DnB</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Rejected_State</targetReference>
            </connector>
            <label>Rejected D&amp;B → Terminal</label>
        </rules>
        <rules>
            <name>Phase_Rejected_KYC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected_KYC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Rejected_State</targetReference>
            </connector>
            <label>Rejected KYC → Terminal</label>
        </rules>
    </decisions>
    <description>F-05b: KYC Check Screen Flow. Phases 2 and 3 of the Finance Approval process. Invoked from the KYC Check quick action on the Account record page. Routes KYC_Pending to KYC Review; KYC_Pending with KYC_Status__c=Approved to Credit Decision (re-entry). On KYC approval, immediately presents the Credit Decision screen in the same action. [reactivated 2026-05-02]

SFDEV-46: Removed Sales Team field from Get Account node</description>
