    <environments>Default</environments>
    <formulas>
        <name>formula_IsAccountContext</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!recordId})), BEGINS({!recordId}, &quot;001&quot;))</expression>
    </formulas>
    <formulas>
        <name>formula_LossNotesLen</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!var_newOpp.Loss_Notes__c}), 0, LEN({!var_newOpp.Loss_Notes__c}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_OppCurrency</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_CountryCurrency.Currency_ISO_Code__c}), &quot;USD&quot;, {!Get_CountryCurrency.Currency_ISO_Code__c})</expression>
    </formulas>
    <formulas>
        <name>formula_Stage</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!var_newOpp.Forecast_Status__c}) = &quot;Lost&quot;, &quot;9-Lost&quot;, IF(TEXT({!var_newOpp.Forecast_Status__c}) = &quot;Won&quot;, &quot;5-Won&quot;, &quot;1-Suspect&quot;))</expression>
    </formulas>
