    <decisions>
        <name>Check_LossReason</name>
        <label>Loss Reason Required?</label>
        <locationX>380</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Get_Site</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>OK</defaultConnectorLabel>
        <rules>
            <name>Lost_No_Reason</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>var_newOpp.Forecast_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_newOpp.Loss_Reason__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>formula_LossNotesLen</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_LossReasonError</targetReference>
            </connector>
            <label>Lost Without Reason</label>
        </rules>
    </decisions>
