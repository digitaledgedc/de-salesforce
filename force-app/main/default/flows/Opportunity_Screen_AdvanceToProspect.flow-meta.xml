    <description>Screen flow for the Advance to 2-Prospect quick action. Collects qualification fields and advances the Opportunity to stage 2-Prospect. Dynamic: End User Customer (Channel Partner) shows when Sales Motion = Resale; Referral Partner shows when Sales Motion = Referral. v1</description>
    <environments>Default</environments>
    <formulas>
        <name>frmMissingFields</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!var_opp.Product_Interest__c}), &quot;Product Interest, &quot;, &quot;&quot;)
 &amp; IF(ISBLANK(TEXT({!var_opp.Sales_Motion__c})), &quot;Sales Motion, &quot;, &quot;&quot;)
 &amp; IF(AND(TEXT({!var_opp.Sales_Motion__c}) = &quot;Referral&quot;, ISBLANK({!var_opp.Referral_Partner__c})), &quot;Referral Partner, &quot;, &quot;&quot;)</expression>
    </formulas>
