                <elementReference>input_DnB_Rating</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finance_Approval_Phase__c</field>
            <value>
                <stringValue>KYC_Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tax_ID__c</field>
            <value>
                <elementReference>input_Tax_ID</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_DnB_Rejected</name>
        <label>Update - D&amp;B Rejected</label>
        <locationX>400</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_DnB_Rejected_Confirm</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Flow_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>D_B_Number__c</field>
            <value>
                <elementReference>input_DnB_Number</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DnB_Check_Date__c</field>
            <value>
                <elementReference>input_DnB_CheckDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DnB_Rating__c</field>
            <value>
                <elementReference>input_DnB_Rating</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finance_Approval_Phase__c</field>
            <value>
                <stringValue>Rejected_DnB</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tax_ID__c</field>
            <value>
                <elementReference>input_Tax_ID</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
