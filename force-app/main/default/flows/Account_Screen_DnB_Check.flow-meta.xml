<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>choice_DnB_Approve</name>
        <choiceText>Approve</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Approve</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_DnB_Reject</name>
        <choiceText>Reject</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Reject</stringValue>
        </value>
    </choices>
    <decisions>
        <name>DnB_Decision_Route</name>
        <label>D&amp;B Decision Route</label>
        <locationX>400</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Update_DnB_Rejected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Reject</defaultConnectorLabel>
        <rules>
            <name>DnB_Approved_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_DnB_Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_DnB_Approved</targetReference>
            </connector>
            <label>Approve</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Phase_Are_We_In</name>
        <label>What Phase Are We In?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Screen_Wrong_Phase</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Phase - Not Applicable</defaultConnectorLabel>
        <rules>
            <name>Phase_Not_Started</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not_Started</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_DnB_Review</targetReference>
            </connector>
            <label>Not Started → D&amp;B Review</label>
        </rules>
        <rules>
            <name>Phase_DnB_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DnB_Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_DnB_Review</targetReference>
            </connector>
            <label>D&amp;B Pending → D&amp;B Review</label>
        </rules>
        <rules>
            <name>Phase_Already_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Already_Approved</targetReference>
            </connector>
            <label>Already Approved → Terminal</label>
        </rules>
        <rules>
            <name>Phase_Rejected</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected_DnB</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Rejected_State</targetReference>
            </connector>
            <label>Rejected State → Terminal</label>
        </rules>
    </decisions>
    <description>F-05a: D&amp;B Check Screen Flow. Phase 1 of the Finance Approval process. Invoked from the D&amp;B Check quick action on the Account record page. Valid phases: Not_Started, DnB_Pending. Saves D&amp;B rating, DUNS number, check date, Tax ID, and advances phase to KYC_Pending (or Rejected_DnB).</description>
    <interviewLabel>Account D&amp;B Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Screen - D&amp;B Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
