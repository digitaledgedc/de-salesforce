<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_Is_Disqualified</name>
        <label>Is Lead Disqualified?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Screen_Not_Disqualified</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Disqualified</defaultConnectorLabel>
        <rules>
            <name>rule_IsDisqualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Disqualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Reopen</targetReference>
            </connector>
            <label>Yes - Disqualified</label>
        </rules>
    </decisions>
    <description>LEAD-004: Screen flow to reopen a Disqualified lead. Captures re-open reason, resets Status to Working, sets Previously_Disqualified__c flag, and creates an activity record. Invoked from the Reopen Lead action on the Lead record page (restricted to Sales Manager via Dynamic Actions).</description>
    <formulas>
        <name>formula_TaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Lead reopened by &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot; on &quot; &amp; TEXT({!$Flow.CurrentDate}) &amp; &quot;.&quot; &amp; BR() &amp; BR() &amp; &quot;Previous Disqualification Reason: &quot; &amp; TEXT({!Get_Lead.Disqualification_Reason__c}) &amp; BR() &amp; &quot;Reopen Reason: &quot; &amp; {!inp_ReopenReason}</expression>
    </formulas>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Lead Reopened from Disqualified: &quot; &amp; {!Get_Lead.FirstName} &amp; &quot; &quot; &amp; {!Get_Lead.LastName} &amp; &quot; (&quot; &amp; {!Get_Lead.Company} &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>Lead Screen Reopen Disqualified {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Screen - Reopen Disqualified</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Reopen_Task</name>
        <label>Create Reopen Activity</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_TaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Lead.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Is_Disqualified</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Company</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Disqualification_Reason__c</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>IsConverted</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Lead_Reopen</name>
        <label>Reset Lead to Working</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Create_Reopen_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Working</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Screen_Not_Disqualified</name>
        <label>Cannot Reopen</label>
        <locationX>440</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Error</name>
            <fieldText>&lt;p&gt;&lt;b style=&quot;color: rgb(194, 57, 52);&quot;&gt;This Lead is not in Disqualified status.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Only Disqualified leads can be reopened using this action.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Reopen</name>
        <label>Reopen Disqualified Lead</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Lead_Reopen</targetReference>
        </connector>
        <fields>
            <name>Display_Reopen_Info</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Reopen this Disqualified Lead.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;This lead was disqualified for: &lt;b&gt;{!Get_Lead.Disqualification_Reason__c}&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Status will be reset to &lt;b&gt;Working&lt;/b&gt;. Provide a reason for reopening.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_ReopenReason</name>
            <fieldText>Reopen Reason</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
