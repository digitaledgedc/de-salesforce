<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>choice_CustomerRequest</name>
        <choiceText>Customer Request</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Customer_Request</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_DuplicateOrder</name>
        <choiceText>Duplicate Order</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Duplicate_Order</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_Error</name>
        <choiceText>Error</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Error</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_NonPayment</name>
        <choiceText>Non-Payment</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Non_Payment</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_Other</name>
        <choiceText>Other</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Decision_UserConfirmed</name>
        <label>User Confirmed?</label>
        <locationX>374</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Screen_Aborted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Confirmed - Abort</defaultConnectorLabel>
        <rules>
            <name>Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>chk_Confirm</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Cancelled</targetReference>
            </connector>
            <label>Confirmed</label>
        </rules>
    </decisions>
    <description>Screen flow launched from the Cancel Order quick action on Order. Collects the cancellation reason and notes, sets Status to Cancelled, and stamps the cancellation metadata.</description>
    <formulas>
        <name>frmToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Order Cancel Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order - Screen - Cancel Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Update_Order_Cancelled</name>
        <label>Set Order to Cancelled</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Screen_Cancelled</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_CancelError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Cancellation_Notes__c</field>
            <value>
                <elementReference>inp_CancellationNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Cancellation_Reason__c</field>
            <value>
                <elementReference>inp_CancellationReason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Cancelled_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Cancelled_Date__c</field>
            <value>
                <elementReference>frmToday</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </inputAssignments>
        <object>Order</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Screen_Aborted</name>
        <label>Not Cancelled</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>lbl_Aborted</name>
            <fieldText>&lt;p&gt;Cancellation aborted. No changes have been made to the order.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_CancelDetails</name>
        <label>Cancel Order</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_UserConfirmed</targetReference>
        </connector>
        <fields>
            <name>lbl_Warning</name>
            <fieldText>&lt;p&gt;&lt;b style=&quot;color: red;&quot;&gt;Warning: This action cannot be undone.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Cancelling this order will set its status to Cancelled. If this order has already been sent to Odoo, contact the operations team to cancel it in the billing system as well.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_CancellationReason</name>
            <choiceReferences>choice_CustomerRequest</choiceReferences>
            <choiceReferences>choice_DuplicateOrder</choiceReferences>
            <choiceReferences>choice_Error</choiceReferences>
            <choiceReferences>choice_NonPayment</choiceReferences>
            <choiceReferences>choice_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Cancellation Reason</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_CancellationNotes</name>
            <fieldText>Cancellation Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>chk_Confirm</name>
            <dataType>Boolean</dataType>
            <fieldText>I confirm I want to cancel this order. This cannot be undone.</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_CancelError</name>
        <label>Cancellation Error</label>
        <locationX>650</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_CancelError</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The Order could not be cancelled.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Please review the message below, fix the issue and try again. If it keeps happening, contact your system administrator. The Order status has not changed.&lt;/p&gt;&lt;p&gt;Error: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Cancelled</name>
        <label>Order Cancelled</label>
        <locationX>374</locationX>
        <locationY>480</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>lbl_Success</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Order has been cancelled.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;If this order was already in Odoo, notify the operations team to cancel it in the billing system.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_CancelDetails</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
