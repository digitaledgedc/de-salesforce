        <locationX>374</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>var_hasZeroPrice</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Line_Discount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Max_Discount</name>
        <label>Update Max Discount</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>var_maxDiscount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmLineDiscount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Lines</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_Auto</name>
        <label>Set Tier = Auto</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>var_tier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Auto</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote_Discount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_CM</name>
        <label>Set Tier = Country Manager</label>
        <locationX>440</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>var_tier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Country Manager</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote_Discount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_DRC</name>
        <label>Set Tier = DRC</label>
        <locationX>968</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>var_tier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Deal Review Committee</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote_Discount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_VP</name>
        <label>Set Tier = CM + VP</label>
        <locationX>704</locationX>
        <locationY>720</locationY>
        <assignmentItems>
            <assignToReference>var_tier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Country Manager + VP</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Quote_Discount</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Line_Discount</name>
        <label>Line discount higher than current max?</label>
        <locationX>572</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Loop_Lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not higher</defaultConnectorLabel>
        <rules>
            <name>Higher_Discount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmLineDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>var_maxDiscount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Max_Discount</targetReference>
            </connector>
            <label>Higher discount</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Lines_Exist</name>
        <label>Lines Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Lines</defaultConnectorLabel>
        <rules>
            <name>Lines_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_All_Lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Lines</targetReference>
            </connector>
            <label>Lines Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Zero_UnitPrice</name>
        <label>Zero Unit Price?</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Check_Line_Discount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Zero</defaultConnectorLabel>
        <rules>
            <name>Is_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Lines.UnitPrice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Zero_Price</targetReference>
            </connector>
            <label>Zero Price</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Tier</name>
        <label>Determine Approval Tier</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Set_Tier_Auto</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>0-10% Auto</defaultConnectorLabel>
        <rules>
            <name>Tier_DRC</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_maxDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_hasZeroPrice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_DRC</targetReference>
            </connector>
            <label>&gt;30% or Zero Price = DRC</label>
        </rules>
        <rules>
            <name>Tier_VP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_maxDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_VP</targetReference>
            </connector>
            <label>20-30% = CM + VP</label>
        </rules>
        <rules>
            <name>Tier_CM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_maxDiscount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_CM</targetReference>
            </connector>
            <label>10-20% = Country Manager</label>
        </rules>
    </decisions>
    <description>F-14-After: Enhanced discount check. On QLI save, queries all sibling line items, calculates the maximum discount percentage across the quote, and sets the approval tier on the parent Quote. Tiers: 0-10% Auto, 10-20% Country Manager, 20-30% Country Manager + VP, &gt;30% Deal Review Committee.</description>
    <formulas>
        <name>frmLineDiscount</name>
        <dataType>Number</dataType>
        <expression>IF({!Loop_Lines.ListPrice} &gt; 0, ({!Loop_Lines.ListPrice} - {!Loop_Lines.UnitPrice}) / {!Loop_Lines.ListPrice} * 100, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>QLI Discount Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Line Item - After Save - Discount Check</label>
    <loops>
        <name>Loop_Lines</name>
        <label>Loop Line Items</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_All_Lines</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Zero_UnitPrice</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Determine_Tier</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Lines</name>
        <label>Get All Quote Line Items</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Lines_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_Discount</name>
        <label>Update Quote Discount Fields</label>
        <locationX>440</locationX>
        <locationY>840</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Discount_Approval_Required__c</field>
            <value>
                <elementReference>var_hasZeroPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Discount_Approval_Tier__c</field>
            <value>
                <elementReference>var_tier</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Max_Discount_Percent__c</field>
            <value>
                <elementReference>var_maxDiscount</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Lines</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>UnitPrice</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Discount</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Quantity</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
