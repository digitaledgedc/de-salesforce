<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Credit_Block_Subject</name>
        <label>Build Credit Block Task Subject</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>var_financeTaskSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>CREDIT BLOCK APPLIED - </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_financeTaskSubject</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_financeTaskSubject</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> - Overdue AR: USD </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_financeTaskSubject</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>formula_OverdueText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Finance_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Fault_End</name>
        <label>Fault - End Gracefully</label>
        <locationX>754</locationX>
        <locationY>1211</locationY>
        <assignmentItems>
            <assignToReference>var_financeTaskSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Credit_Block_Being_Cleared</name>
        <label>Is Credit Block Being Cleared?</label>
        <locationX>1678</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Not Clearing - End</defaultConnectorLabel>
        <rules>
            <name>Block_Being_Cleared</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Overdue_90_Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Credit_Block__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Credit_Block</targetReference>
            </connector>
            <label>Block Being Cleared</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Finance_Queue_Found</name>
        <label>Finance Queue Found?</label>
        <locationX>314</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Create_Owner_Block_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Queue - Skip Finance Task</defaultConnectorLabel>
        <rules>
            <name>Finance_Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_financeQueue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Finance_Task</targetReference>
            </connector>
            <label>Finance Queue Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Overdue_Greater_Than_Zero</name>
        <label>Is Overdue &gt; 0?</label>
        <locationX>996</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Is_Credit_Block_Being_Cleared</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Overdue</defaultConnectorLabel>
        <rules>
            <name>Overdue_Greater_Than_Zero</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Overdue_90_Days__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Credit_Block</targetReference>
            </connector>
            <label>Overdue &gt; 0</label>
        </rules>
    </decisions>
    <description>F-07: Fires when Overdue_90_Days__c changes on Account. Auto-sets or clears Credit_Block__c and creates Tasks for Finance and Account Owner. When &gt; 0: sets Credit_Block__c = TRUE and creates notification Tasks. When cleared to 0 and block was previously TRUE: clears Credit_Block__c and notifies Account Owner. NOTE: Manual credit blocks set by Finance for non-AR reasons are NOT auto-cleared even when Overdue_90_Days__c drops to 0 - this flow only manages the auto-set path.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_ClearSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Credit block cleared on &quot; &amp; {!$Record.Name} &amp; &quot; - AR overdue balance resolved.&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_OverdueText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Overdue_90_Days__c})</expression>
    </formulas>
    <formulas>
        <name>formula_OwnerBlockSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Credit block applied to &quot; &amp; {!$Record.Name} &amp; &quot; - Contact Finance to resolve.&quot;</expression>
    </formulas>
    <interviewLabel>Account Credit Block {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - After Save - Credit Block</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Finance_Task</name>
        <label>Create Task on Finance Queue</label>
        <locationX>50</locationX>
        <locationY>863</locationY>
        <connector>
            <targetReference>Create_Owner_Block_Task</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>var_financeQueue.Queue_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>var_financeTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Owner_Block_Task</name>
        <label>Create Task on Account Owner</label>
        <locationX>314</locationX>
        <locationY>1103</locationY>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_OwnerBlockSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Owner_Clear_Task</name>
        <label>Create Task - Credit Block Cleared</label>
        <locationX>1282</locationX>
        <locationY>647</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_ClearSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Finance_Queue</name>
        <label>Get Country Finance Queue</label>
        <locationX>314</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Finance_Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Operation_Country__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Finance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Country_Queue__mdt</object>
        <outputReference>var_financeQueue</outputReference>
        <queriedFields>Queue_Id__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Clear_Credit_Block</name>
        <label>Clear Credit Block</label>
        <locationX>1282</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Create_Owner_Clear_Task</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Credit_Block_Reason__c</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Block__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Credit_Block</name>
        <label>Set Credit Block = TRUE</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Build_Credit_Block_Subject</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Credit_Block_Reason__c</field>
            <value>
                <stringValue>Overdue_90_Days</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Block__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>870</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Overdue_Greater_Than_Zero</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Overdue_90_Days__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>var_financeQueue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Country_Queue__mdt</objectType>
    </variables>
    <variables>
        <name>var_financeTaskSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
