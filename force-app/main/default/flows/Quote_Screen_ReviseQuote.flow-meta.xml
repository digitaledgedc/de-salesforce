    <description>F-17: Screen flow to void current Quote and create a new revision. Note: the Aura wrapper (reviseQuoteAction) now calls QuoteRevisionService.reviseQuote directly - this flow is retained for backward compatibility but is no longer invoked by the quick action. Marks original Void, creates revision incrementing Quote_Version__c with Revised_From__c set, then clones all QuoteLineItems via QuoteRevisionService.</description>
    <formulas>
        <name>frmBaseName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!var_quote.Name}, &quot; Rev &quot;),
    LEFT({!var_quote.Name}, FIND(&quot; Rev &quot;, {!var_quote.Name}) - 1),
    {!var_quote.Name}
)</expression>
    </formulas>
    <formulas>
        <name>frmConfirmMessage</name>
        <dataType>String</dataType>
        <expression>&quot;You are about to void Quote: &quot; &amp; {!var_quote.Name} &amp; &quot; and create a new revision (&quot; &amp; {!frmBaseName} &amp; &quot; Rev &quot; &amp; TEXT({!var_quote.Quote_Version__c} + 1) &amp; &quot;). All line items will be copied. The original will be marked Void. Click Next to proceed.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmNewQuoteName</name>
        <dataType>String</dataType>
        <expression>{!frmBaseName} &amp; &quot; Rev &quot; &amp; TEXT({!var_quote.Quote_Version__c} + 1)</expression>
    </formulas>
    <formulas>
        <name>frmNewVersion</name>
        <dataType>Number</dataType>
        <expression>{!var_quote.Quote_Version__c} + 1</expression>
        <scale>0</scale>
    </formulas>
