    <description>F-19: Order Confirmation Flow. Evaluates 12 hard gates before setting Order.Status = Confirmed and invoking IP-1 Odoo integration. Gate logic for G-01/G-02 (BAN), G-03/G-04 (Inventory), G-07/G-08/G-09 (SBI/Deposit/Credit) will be activated in Modules 7/9. IP-1 Apex action activated in Module 12.</description>
    <formulas>
        <name>frmAllGatesPass</name>
        <dataType>Boolean</dataType>
        <expression>AND({!frmRDDValid}, {!frmG11Pass}, {!frmG05Pass}, {!frmG06Pass}, {!frmDeferredGatesPass})</expression>
    </formulas>
    <formulas>
        <name>frmDeferredGatesPass</name>
        <dataType>Boolean</dataType>
        <expression>true</expression>
    </formulas>
    <formulas>
        <name>frmG05Pass</name>
        <dataType>Boolean</dataType>
        <expression>true</expression>
    </formulas>
    <formulas>
        <name>frmG06FailureMessage</name>
        <dataType>String</dataType>
        <expression>IF({!frmG06Pass}, &quot;&quot;, &quot;G-06: Order has no products. Add at least one Order Product (via the SOF upload process) before confirming.&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmG06Pass</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!var_firstOrderItem.Id}))</expression>
    </formulas>
    <formulas>
        <name>frmG10FailureMessage</name>
        <dataType>String</dataType>
        <expression>IF({!frmRDDValid}, &quot;&quot;, &quot;G-10: Requested Delivery Date is missing or in the past. Update RDD to a current or future date.&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmG11FailureMessage</name>
        <dataType>String</dataType>
        <expression>IF({!frmG11Pass}, &quot;&quot;, &quot;G-11: Churn Orders require explicit approval. Submit the Churn Order Approval before confirming.&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmG11Pass</name>
        <dataType>Boolean</dataType>
        <expression>OR(NOT(ISPICKVAL({!var_order.Order_Type__c}, &quot;Churn&quot;)), {!var_order.Churn_Approved__c})</expression>
    </formulas>
    <formulas>
        <name>frmOrderSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Order: &quot; &amp; {!var_order.Order_Number__c} &amp; &quot; | Type: &quot; &amp; TEXT({!var_order.Order_Type__c}) &amp; &quot; | Site: &quot; &amp; TEXT({!var_order.Operation_Site__c}) &amp; &quot; | RDD: &quot; &amp; TEXT({!var_order.RDD__c}) &amp; &quot; | Term: &quot; &amp; TEXT({!var_order.Contract_Term_Months__c}) &amp; &quot; months&quot;</expression>
    </formulas>
    <formulas>
        <name>frmRDDValid</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!var_order.RDD__c})), {!var_order.RDD__c} &gt;= (TODAY() - 1))</expression>
    </formulas>
