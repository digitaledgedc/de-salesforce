<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_CO_Quote</name>
        <label>Is Change Order Quote?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Update_Opp_Full_Accept</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New Quote - sync all fields</defaultConnectorLabel>
        <rules>
            <name>CO_Quote</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Original_Order__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opp_Accept_CO</targetReference>
            </connector>
            <label>CO Quote - preserve delta on Opp</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Quote_Accepted</name>
        <label>Is Quote Accepted?</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Totals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Accepted - totals only</defaultConnectorLabel>
        <rules>
            <name>Quote_Accepted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_CO_Quote</targetReference>
            </connector>
            <label>Accepted - Status just changed</label>
        </rules>
    </decisions>
    <description>F-23: When a Quote is saved, syncs financial totals to the linked Opportunity.
  - On every save: updates Quote_MRC__c, Quote_NRC__c, Amount for pipeline reporting.
  - On Accepted only: sets Has_Accepted_Quote__c, Primary_Quote__c, and syncs MRC__c/NRC__c.
    For CO quotes (Original_Order__c != null): skips Amount, MRC__c, and NRC__c overwrite so the
    incremental delta set by createChangeOrder is preserved on the Opportunity.
    Does NOT set StageName - Opp stays at 4-Negotiate until Order is confirmed.
  Guards: skips Won Opps in both paths to prevent VR_OPP_12/13 from double-fire during SOFHandler.</description>
    <environments>Default</environments>
    <label>Quote After Save Sync To Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
