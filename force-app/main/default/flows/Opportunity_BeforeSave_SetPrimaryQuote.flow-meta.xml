<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Primary_Quote</name>
        <label>Stamp Primary Quote on Opportunity</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>$Record.Primary_Quote__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_AcceptedQuote.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_QuoteFound</name>
        <label>Accepted Quote Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Accepted Quote - exit, leave Primary_Quote__c as-is</defaultConnectorLabel>
        <rules>
            <name>Quote_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_AcceptedQuote</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Primary_Quote</targetReference>
            </connector>
            <label>Quote Found - stamp it</label>
        </rules>
    </decisions>
    <description>F-24: Opportunity before-save flow. When StageName changes to 5-Won, looks up the most recently accepted Quote on this Opportunity and stamps Primary_Quote__c directly on $Record. Runs in system context before VR_OPP_01_Won_Requires_Quote evaluates - ensures the field is always populated when an accepted Quote exists, regardless of what triggered the stage change (screen flow, after-save automation, or manual edit). Belt-and-suspenders companion to Quote_AfterSave_SyncToOpportunity.</description>
    <interviewLabel>Opportunity Before Save Set Primary Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Before Save - Set Primary Quote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_AcceptedQuote</name>
        <label>Get Accepted Quote for this Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_QuoteFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Accepted</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_AcceptedQuote</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>5-Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
