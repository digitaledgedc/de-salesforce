    <decisions>
        <name>Dec_CompetitorRequired</name>
        <label>Competitor Required?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Update_Opportunity_Loss</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Competitor</defaultConnectorLabel>
        <rules>
            <name>Competitor_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>input_LossReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Competitor Decision</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Competitor</targetReference>
            </connector>
            <label>Competitor Decision</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dec_QuoteExists</name>
