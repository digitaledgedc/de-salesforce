        <locationX>182</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Create_Lost_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Quote</defaultConnectorLabel>
        <rules>
            <name>Quote_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_opportunity.SyncedQuoteId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Void_Quote</targetReference>
            </connector>
            <label>Quote Found</label>
        </rules>
    </decisions>
    <description>F-09: Mark as Lost capture screen flow. Captures Loss_Reason__c, Loss_Notes__c; if Competitor Decision, also captures Competitor__c. Stamps Closed_Lost_Date__c, sets ForecastCategory to Omitted, voids the synced Quote, and logs a Task. Won is handled automatically by Order_AfterSave_WonAutoClose when Order Status = Confirmed.

V2:  removed the Input screen validation on Loss Notes (12/08/2026)
V3 : changes Loss Note Label</description>
    <environments>Default</environments>
    <formulas>
        <name>frm_TaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Loss Reason: &quot; &amp; {!input_LossReason} &amp; IF(NOT(ISBLANK({!input_Competitor})), &quot; | Competitor: &quot; &amp; {!input_Competitor}, &quot;&quot;) &amp; &quot; | Notes: &quot; &amp; {!input_LossNotes}</expression>
    </formulas>
    <formulas>
        <name>frmFriendlyError</name>
        <dataType>String</dataType>
        <expression>IF(AND(CONTAINS({!$Flow.FaultMessage}, &quot;_EXCEPTION: &quot;), CONTAINS({!$Flow.FaultMessage}, &quot;. You can look up&quot;)), MID({!$Flow.FaultMessage}, FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12, FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) - (FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12)), {!$Flow.FaultMessage})</expression>
    </formulas>
