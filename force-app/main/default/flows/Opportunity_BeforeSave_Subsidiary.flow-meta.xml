<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Subsidiary_From_Site</name>
        <label>Set Subsidiary From Site</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <assignmentItems>
            <assignToReference>$Record.DE_Entity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Target_Site__r.DE_Entity__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Target_Site</name>
        <label>Has Target Site?</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <defaultConnectorLabel>No Site</defaultConnectorLabel>
        <rules>
            <name>Site_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Target_Site__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Subsidiary_From_Site</targetReference>
            </connector>
            <label>Site Populated</label>
        </rules>
    </decisions>
    <description>Auto-populates the Subsidiary (DE_Entity__c) on Opportunity from the Target Site when Target_Site__c is set or changed. Clears subsidiary if site is removed.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity - Before Save - Subsidiary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Before Save - Subsidiary</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Target_Site</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Target_Site__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Target_Site__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
