            <targetReference>screenSelectProducts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Site Set</defaultConnectorLabel>
        <rules>
            <name>No_Target_Site</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTargetSiteId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
