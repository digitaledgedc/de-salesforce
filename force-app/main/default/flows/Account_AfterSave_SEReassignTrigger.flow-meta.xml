<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Clear_SE_On_Loop_Var</name>
        <label>Clear SE On Loop Variable</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>Loop_Open_Opps.Sales_Engineer__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNullId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_OppsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Open_Opps</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Opps</targetReference>
        </connector>
    </assignments>
    <description>Companion to Opportunity_BeforeSave_AssignSE. That flow only fires on an Opportunity save, so it never sees Account_Tier__c or Unique_Name__c changes on the parent Account. This flow catches those changes and blanks Sales_Engineer__c on every open (IsClosed=false) child Opportunity, which forces Opportunity_BeforeSave_AssignSE&apos;s own blank-SE branch to re-derive the tag against the Account&apos;s new state (By_Account now checked first via Unique_Name__c, falling back to Name). Closed Won/Lost Opportunities are left untouched, matching the SE-freeze-on-close rule.</description>
    <interviewLabel>Account SE Reassign Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - After Save - SE Reassign Trigger</label>
    <loops>
        <name>Loop_Open_Opps</name>
        <label>Loop Open Child Opportunities</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <collectionReference>Get_Open_Child_Opps</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Clear_SE_On_Loop_Var</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Opps_Clear_SE</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Child_Opps</name>
        <label>Get Open Child Opportunities</label>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Open_Opps</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opps_Clear_SE</name>
        <label>Update Opportunities - Clear SE</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <inputReference>var_OppsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Child_Opps</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Account_Tier__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Unique_Name__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>var_OppsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
    <variables>
        <name>varNullId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
