<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Task_Description</name>
        <label>Build Task Description</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Lead ID: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> | Country: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Target_Country__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> | Products: </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Product_Interest__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Interconnect_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Fault_End</name>
        <label>Fault - End Gracefully</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>var_taskDesc</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Queue_Found</name>
        <label>Interconnect Queue Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Queue - End</defaultConnectorLabel>
        <rules>
            <name>Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_interconnectQueue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Task_Description</targetReference>
            </connector>
            <label>Queue Found</label>
        </rules>
    </decisions>
    <description>F-03b: Fires when Interconnect_Required__c is set to TRUE on a Lead. Creates a Task on the Interconnect Specialist queue. Companion to F-03 (Before Save) which handles queue field assignment - this flow handles the notification DML which cannot run in Before Save context.</description>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Interconnect opportunity attached to Lead: &quot; &amp; {!$Record.Company}</expression>
    </formulas>
    <interviewLabel>Lead Interconnect Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - After Save - Interconnect Notify</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Interconnect_Task</name>
        <label>Create Task on Interconnect Queue</label>
        <locationX>374</locationX>
        <locationY>480</locationY>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>var_taskDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Interconnect_Queue</name>
        <label>Get Interconnect Queue CMT Record</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Interconnect</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Country_Queue__mdt</object>
        <outputReference>var_interconnectQueue</outputReference>
        <queriedFields>Queue_Id__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Interconnect_Queue</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Product_Interest__c</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Interconnect</stringValue>
            </value>
        </filters>
        <filters>
            <field>Product_Interest__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_interconnectQueue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Country_Queue__mdt</objectType>
    </variables>
    <variables>
        <name>var_taskDesc</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
