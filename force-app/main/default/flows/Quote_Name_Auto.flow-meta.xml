<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_Seq</name>
        <label>Increment Sequence</label>
        <locationX>308</locationX>
        <locationY>494</locationY>
        <assignmentItems>
            <assignToReference>QuoteSeq</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Count_Loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Quote_Name</name>
        <label>Set Quote Name</label>
        <locationX>176</locationX>
        <locationY>494</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>QuoteName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Quote_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>QuoteName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Before-save flow on Quote (Create only). Sets Name = {Opportunity_Number__c}-QT-{N} where N is the sequential count of quotes already on this Opportunity plus 1. SDD §Quote - Name.</description>
    <environments>Default</environments>
    <formulas>
        <name>QuoteName</name>
        <dataType>String</dataType>
        <expression>{!Get_Opportunity.Opportunity_Number__c} &amp; &quot;-QT-&quot; &amp; TEXT({!QuoteSeq})</expression>
    </formulas>
    <interviewLabel>Quote Name Auto {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Name Auto</label>
    <loops>
        <name>Count_Loop</name>
        <label>Count Existing Quotes</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <collectionReference>Get_Existing_Quotes</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Seq</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Set_Quote_Name</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Existing_Quotes</name>
        <label>Get Existing Quotes for Opportunity</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity Number</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Existing_Quotes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Opportunity_Number__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Quote</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>QuoteSeq</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </variables>
</Flow>
