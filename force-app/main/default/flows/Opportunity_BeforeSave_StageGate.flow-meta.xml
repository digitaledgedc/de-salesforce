    <description>V2 : Edited the condition in &apos;Stage 9 Validation&apos; decision element.  from 50 -&gt; 5 (12/08/2026)</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_CurrencyCode</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;HK&apos;), &apos;HKD&apos;, IF(OR(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;TYO&apos;), BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;OSA&apos;)), &apos;JPY&apos;, IF(OR(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;SEL&apos;), BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;PUS&apos;)), &apos;KRW&apos;, IF(OR(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;JKT&apos;), BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;CGK&apos;)), &apos;IDR&apos;, IF(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;MNL&apos;), &apos;PHP&apos;, IF(BEGINS({!$Record.Target_Site__r.Site_Code__c}, &apos;SG&apos;), &apos;SGD&apos;, &apos;USD&apos;))))))</expression>
    </formulas>
    <formulas>
        <name>formula_LossNotesLen</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Loss_Notes__c}), 0, LEN({!$Record.Loss_Notes__c}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_RevOpsBackward</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Permission.Bypass_Opp_Stage_Gate}, CASE(TEXT({!$Record.StageName}), &apos;1-Suspect&apos;,1, &apos;2-Prospect&apos;,2, &apos;3-Quote&apos;,3, &apos;4-Negotiate&apos;,4, &apos;5-Won&apos;,5, &apos;9-Lost&apos;,9, 0) &lt; CASE(TEXT(PRIORVALUE({!$Record.StageName})), &apos;1-Suspect&apos;,1, &apos;2-Prospect&apos;,2, &apos;3-Quote&apos;,3, &apos;4-Negotiate&apos;,4, &apos;5-Won&apos;,5, &apos;9-Lost&apos;,9, 0))</expression>
    </formulas>
