<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Any_Products_Missing</name>
        <label>Any Products Missing Odoo ID?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No products missing - no action</defaultConnectorLabel>
        <rules>
            <name>Products_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_productsWithoutOdooId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RevOps_Queue</targetReference>
            </connector>
            <label>Products Found</label>
        </rules>
    </decisions>
    <description>F-31: Daily scheduled flow. Queries active Product2 records where Odoo_Product_Id__c is null. If any found, creates a summary task on the Revenue Operations queue. Ensures product catalog integrity for Odoo integration.</description>
    <formulas>
        <name>frmDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel>Product Odoo ID Null Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Product - Scheduled - Odoo ID Null Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Alert_Task</name>
        <label>Create Alert Task</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>frmDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Daily audit found active products without an Odoo Product ID. These products cannot be synced to BOSS and may cause integration failures when used in Orders.

Action required: Update Odoo_Product_Id__c on affected products. Use the Products list view filtered by &quot;Odoo Product ID equals blank&quot; and &quot;Active equals true&quot; to find all affected records.

If a product should not have an Odoo ID (e.g. internal-only), deactivate it or document the exception.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_RevOps_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Product Catalog Alert: Active products missing Odoo Product ID</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Products_Missing_OdooId</name>
        <label>Get Active Products Missing Odoo ID</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Products_Missing</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Odoo_Product_Id__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Product2</object>
        <outputReference>col_productsWithoutOdooId</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_RevOps_Queue</name>
        <label>Get Revenue Operations Queue</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Alert_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DE_Revenue_Operations</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Products_Missing_OdooId</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-05-18</startDate>
            <startTime>06:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_productsWithoutOdooId</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Product2</objectType>
    </variables>
</Flow>
