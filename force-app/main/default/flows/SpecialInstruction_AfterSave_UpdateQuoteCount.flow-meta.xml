<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_Count</name>
        <label>Increment Count</label>
        <locationX>264</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>var_pendingCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Pending_SIs</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Quote_Locked_CustomError</name>
        <label>Quote In Review</label>
        <locationX>500</locationX>
        <locationY>612</locationY>
        <customErrorMessages>
            <errorMessage>This quote is in review and is awaiting approval from the Capacity Manager and Country Manager. You can acknowledge this Special Instruction once the quote has been approved.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Count_Changed</name>
        <label>Count Changed?</label>
        <locationX>176</locationX>
        <locationY>552</locationY>
        <defaultConnectorLabel>Same - Skip Update</defaultConnectorLabel>
        <rules>
            <name>Count_Is_Different</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_pendingCount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Current_Quote.Pending_Instructions_Count__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Quote_Count</targetReference>
            </connector>
            <label>Count Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Quote</name>
        <label>Has Quote?</label>
        <locationX>176</locationX>
        <locationY>172</locationY>
        <defaultConnectorLabel>No Quote - Skip</defaultConnectorLabel>
        <rules>
            <name>Quote_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Pending_SIs</targetReference>
            </connector>
            <label>Has Quote</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Auto_Expired</name>
        <label>Auto-Expired?</label>
        <locationX>176</locationX>
        <locationY>90</locationY>
        <defaultConnector>
            <targetReference>Has_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Auto-Expired</defaultConnectorLabel>
        <rules>
            <name>Skip_If_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <label>Skip - Expired</label>
        </rules>
    </decisions>
    <description>Maintains Quote.Pending_Instructions_Count__c by counting all Special_Instruction__c records with Status = Pending for the parent Quote. Fires on SI create and update.</description>
    <interviewLabel>SI Update Quote Count {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SpecialInstruction - After Save - Update Quote Count</label>
    <loops>
        <name>Loop_Pending_SIs</name>
        <label>Count Pending SIs</label>
        <locationX>176</locationX>
        <locationY>372</locationY>
        <collectionReference>var_pendingSIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Current_Quote</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Current_Quote</name>
        <label>Get Current Quote Count</label>
        <locationX>176</locationX>
        <locationY>492</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Pending_Instructions_Count__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Pending_SIs</name>
        <label>Get Pending SIs for Quote</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Pending_SIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Quote__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Special_Instruction__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Quote_Count</name>
        <label>Update Quote Pending Count</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <faultConnector>
            <targetReference>Quote_Locked_CustomError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Pending_Instructions_Count__c</field>
            <value>
                <elementReference>var_pendingCount</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Auto_Expired</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Special_Instruction__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_pendingCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>var_pendingSIs</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Special_Instruction__c</objectType>
    </variables>
</Flow>
