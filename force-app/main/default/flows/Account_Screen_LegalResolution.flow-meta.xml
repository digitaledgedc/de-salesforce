<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>choice_Legal_Cleared</name>
        <choiceText>Legal Cleared — Proceed to Approval</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Cleared</stringValue>
        </value>
    </choices>
    <choices>
        <name>choice_Legal_Rejected</name>
        <choiceText>Legal Rejected — Block Customer</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Rejected</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Check_Phase</name>
        <label>Is Legal Review Pending?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Screen_Not_Applicable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not in Legal Review</defaultConnectorLabel>
        <rules>
            <name>Is_Legal_Pending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_account.Finance_Approval_Phase__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Legal_Review_Pending</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Legal_Decision</targetReference>
            </connector>
            <label>Legal Review Pending</label>
        </rules>
    </decisions>
    <decisions>
        <name>Legal_Decision_Route</name>
        <label>Legal Decision Route</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Update_Legal_Rejected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Rejected</defaultConnectorLabel>
        <rules>
            <name>Legal_Cleared_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inp_Legal_Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cleared</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Legal_Cleared</targetReference>
            </connector>
            <label>Cleared</label>
        </rules>
    </decisions>
    <description>Legal Resolution action for Accounts in Legal_Review_Pending phase. Available to Legal and System Administrator profiles. Allows legal to clear the account (returns to KYC_Pending for finance resubmission) or permanently reject.</description>
    <interviewLabel>Account Legal Resolution {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Screen - Legal Resolution</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Phase</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Flow_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>var_account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Finance_Approval_Phase__c</queriedFields>
        <queriedFields>Finance_Rejection_Reason__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Legal_Cleared</name>
        <label>Update - Legal Cleared</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Legal_Cleared_Confirm</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Flow_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Finance_Approval_Phase__c</field>
            <value>
                <stringValue>KYC_Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finance_Rejection_Reason__c</field>
            <value>
                <elementReference>inp_Legal_Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>KYC_Status__c</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Legal_Rejected</name>
        <label>Update - Legal Rejected</label>
        <locationX>400</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Legal_Rejected_Confirm</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Flow_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Finance_Approval_Phase__c</field>
            <value>
                <stringValue>Rejected_KYC</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finance_Rejection_Reason__c</field>
            <value>
                <elementReference>inp_Legal_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <runInMode>SystemModeWithSharing</runInMode>
    <screens>
        <name>Screen_Flow_Error</name>
        <label>Error</label>
        <locationX>700</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>error_message_display</name>
            <fieldText>&lt;p&gt;&lt;b&gt;An error occurred.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Please contact your system administrator.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Legal_Cleared_Confirm</name>
        <label>Legal Cleared</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_Legal_Cleared</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Legal review complete — cleared.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The Account has been returned to KYC Pending status. Finance can now resubmit the KYC approval using the Finance Approval action.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Legal_Decision</name>
        <label>Legal Resolution</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Legal_Decision_Route</targetReference>
        </connector>
        <fields>
            <name>disp_Legal_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Legal Resolution — {!var_account.Name}&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin-top:8px;color:#555&quot;&gt;This account was rejected at the KYC stage by Finance and requires legal review.&lt;/p&gt;&lt;p style=&quot;margin-top:8px;padding:8px 12px;background:#fef0f0;border-left:4px solid #e00;border-radius:2px;font-size:13px&quot;&gt;&lt;b&gt;Finance Rejection Reason:&lt;/b&gt; {!var_account.Finance_Rejection_Reason__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>comp_legal_doc_upload</name>
            <extensionName>c:recordFileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>cardTitle</name>
                <value>
                    <stringValue>Legal Documents</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>cardSubtitle</name>
                <value>
                    <stringValue>Attach legal review documents and clearance evidence</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Account</stringValue>
                </value>
            </inputParameters>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_Legal_Notes</name>
            <fieldText>Legal Review Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>inp_Legal_Decision</name>
            <choiceReferences>choice_Legal_Cleared</choiceReferences>
            <choiceReferences>choice_Legal_Rejected</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Legal Decision</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Submit Legal Decision</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Legal_Rejected_Confirm</name>
        <label>Legal Rejected</label>
        <locationX>400</locationX>
        <locationY>720</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_Legal_Rejected</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Legal review complete — rejected.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The Account has been permanently rejected. Sales has been notified that no binding quotes can proceed for this customer.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Not_Applicable</name>
        <label>Not Applicable</label>
        <locationX>400</locationX>
        <locationY>360</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>display_Not_Applicable</name>
            <fieldText>This Account is not in Legal Review Pending status. The Legal Resolution action is only available for accounts that have been rejected at the KYC stage and referred for legal review.</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
</Flow>
