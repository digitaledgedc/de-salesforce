<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Any_Stalled_Accounts</name>
        <label>Any Stalled Accounts?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Stalled Accounts - End</defaultConnectorLabel>
        <rules>
            <name>Stalled_Accounts_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_stalledAccounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Stalled_Accounts</targetReference>
            </connector>
            <label>Stalled Accounts Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Finance_Queue_Found</name>
        <label>Finance Queue Found?</label>
        <locationX>572</locationX>
        <locationY>600</locationY>
        <defaultConnector>
            <targetReference>Loop_Stalled_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Queue - Skip Task</defaultConnectorLabel>
        <rules>
            <name>Queue_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_countryFinanceQueue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task</targetReference>
            </connector>
            <label>Queue Found</label>
        </rules>
    </decisions>
    <description>F-08: Runs daily at 03:00 HKT. Finds all Accounts stuck in a Finance pending phase (DnB_Pending, KYC_Pending, Legal_Review) where Finance_Approval_Phase_Changed__c is 5 or more days ago. Creates a High-priority Task on the Country Finance queue for each stalled account, and increments Finance_Approval_Reminder_Count__c to track escalation volume. Does not create duplicate tasks if a task was already created today (guarded by Finance_Approval_Phase_Changed__c moving forward after each phase transition).</description>
    <formulas>
        <name>formula_5DaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 5</expression>
    </formulas>
    <formulas>
        <name>formula_IncrementedCount</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!Loop_Stalled_Accounts.Finance_Approval_Reminder_Count__c}), 1, {!Loop_Stalled_Accounts.Finance_Approval_Reminder_Count__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formula_TaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Finance approval for &quot; &amp; {!Loop_Stalled_Accounts.Name} &amp; &quot; has been in &quot; &amp; TEXT({!Loop_Stalled_Accounts.Finance_Approval_Phase__c}) &amp; &quot; since &quot; &amp; TEXT({!Loop_Stalled_Accounts.Finance_Approval_Phase_Changed__c}) &amp; &quot;. Action required: advance or reject using the Finance Approval quick action on the Account record.&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;FINANCE APPROVAL STALLED - &quot; &amp; {!Loop_Stalled_Accounts.Name} &amp; &quot; (Phase: &quot; &amp; TEXT({!Loop_Stalled_Accounts.Finance_Approval_Phase__c}) &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>Account Finance Approval Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Scheduled - Finance Approval Reminder</label>
    <loops>
        <name>Loop_Stalled_Accounts</name>
        <label>Loop Stalled Accounts</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <collectionReference>col_stalledAccounts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Country_Finance_Queue</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Reminder_Task</name>
        <label>Create Finance Approval Reminder Task</label>
        <locationX>572</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Loop_Stalled_Accounts</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>formula_TaskDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_TaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>var_countryFinanceQueue.Queue_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>Loop_Stalled_Accounts.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Country_Finance_Queue</name>
        <label>Get Country Finance Queue for Account</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Reminder_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Stalled_Accounts.Operation_Country__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Finance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Country_Queue__mdt</object>
        <outputReference>var_countryFinanceQueue</outputReference>
        <queriedFields>Queue_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Stalled_Accounts</name>
        <label>Get Accounts Stalled in Finance Pending</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Stalled_Accounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Finance_Approval_Phase__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Not_Started</stringValue>
            </value>
        </filters>
        <filters>
            <field>Finance_Approval_Phase__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Finance_Approval_Phase__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected_DnB</stringValue>
            </value>
        </filters>
        <filters>
            <field>Finance_Approval_Phase__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected_KYC</stringValue>
            </value>
        </filters>
        <filters>
            <field>Finance_Approval_Phase_Changed__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>formula_5DaysAgo</elementReference>
            </value>
        </filters>
        <filters>
            <field>Finance_Approval_Phase_Changed__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>col_stalledAccounts</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Finance_Approval_Phase__c</queriedFields>
        <queriedFields>Finance_Approval_Phase_Changed__c</queriedFields>
        <queriedFields>Finance_Approval_Reminder_Count__c</queriedFields>
        <queriedFields>Operation_Country__c</queriedFields>
        <queriedFields>OwnerId</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Reminder_Count</name>
        <label>Increment Finance Approval Reminder Count</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Finance_Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Stalled_Accounts.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Finance_Approval_Reminder_Count__c</field>
            <value>
                <elementReference>formula_IncrementedCount</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Stalled_Accounts</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-04-25</startDate>
            <startTime>19:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_stalledAccounts</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>var_countryFinanceQueue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Country_Queue__mdt</objectType>
    </variables>
</Flow>
