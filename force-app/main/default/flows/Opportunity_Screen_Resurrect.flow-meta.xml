<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>OPP-2: Sales Manager action to re-open a Lost opportunity. Captures Resurrect_Reason__c, resets Stage to 2-Prospect, extends Close Date by 90 days, stamps Resurrection_Date__c and Was_Previously_Lost__c, and logs a Task. Restricted to Sales Manager profile via Dynamic Actions on the Opportunity record page.</description>
    <formulas>
        <name>frm_NewCloseDate</name>
        <dataType>Date</dataType>
        <expression>$Flow.CurrentDate + 90</expression>
    </formulas>
    <formulas>
        <name>frm_ResurrectTaskDesc</name>
        <dataType>String</dataType>
        <expression>&quot;Opportunity resurrected from Lost status. Reason: &quot; &amp; {!input_ResurrectReason}</expression>
    </formulas>
    <interviewLabel>Opportunity Resurrect {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Screen - Resurrect Opportunity</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Resurrect_Task</name>
        <label>Log Resurrect Activity</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>frm_ResurrectTaskDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Opportunity Resurrected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>132</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Resurrect_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>var_opportunity</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>StageName</queriedFields>
        <queriedFields>Loss_Reason__c</queriedFields>
        <queriedFields>Closed_Lost_Date__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Opportunity_Resurrect</name>
        <label>Reset Stage and Stamp Resurrect Fields</label>
        <locationX>176</locationX>
        <locationY>522</locationY>
        <connector>
            <targetReference>Create_Resurrect_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CloseDate</field>
            <value>
                <elementReference>frm_NewCloseDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ForecastCategoryName</field>
            <value>
                <stringValue>Pipeline</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Resurrect_Reason__c</field>
            <value>
                <elementReference>input_ResurrectReason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Resurrection_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>2-Prospect</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Was_Previously_Lost__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <screens>
        <name>Screen_Resurrect_Details</name>
        <label>Resurrect Opportunity</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Opportunity_Resurrect</targetReference>
        </connector>
        <fields>
            <name>display_ResurrectContext</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!var_opportunity.Name}&lt;/b&gt;&lt;/p&gt;&lt;p&gt;This opportunity is currently &lt;b&gt;Lost&lt;/b&gt;. Resurrecting it will:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Reset the stage to &lt;b&gt;2-Prospect&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Set the Close Date to &lt;b&gt;90 days from today&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Mark the opportunity as &lt;b&gt;Previously Lost&lt;/b&gt; for reporting&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;This action requires Sales Manager authorisation and will be logged in the activity history.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>input_ResurrectReason</name>
            <fieldText>Reason for Resurrection</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText>Why is this opportunity being re-opened? Include any new customer engagement, changed circumstances, or re-qualification details.</helpText>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Resurrect Opportunity</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_opportunity</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
</Flow>
