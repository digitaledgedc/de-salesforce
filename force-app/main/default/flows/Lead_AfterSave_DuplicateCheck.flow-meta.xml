<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Contact_Match_Decision</name>
        <label>Contact Match Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Lead_Match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact Match</defaultConnectorLabel>
        <rules>
            <name>Contact_Match_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_matchedContact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task_On_Contact_Owner</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Open_Lead_Match_Decision</name>
        <label>Open Lead Match Found?</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <defaultConnectorLabel>No Open Lead Match</defaultConnectorLabel>
        <rules>
            <name>Open_Lead_Match_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_matchedLead</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Merge_Into_Existing_Lead</targetReference>
            </connector>
            <label>Open Lead Found</label>
        </rules>
    </decisions>
    <description>F-01: After Lead creation, checks for matching active Contact (sets Duplicate_Flag__c + creates Task on Contact owner). If no Contact match, checks for matching open Lead (merges description, sets flag).</description>
    <formulas>
        <name>formula_ContactTaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Lead record attempted for: &quot; &amp; {!$Record.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastName} &amp; &quot; | Company: &quot; &amp; {!$Record.Company} &amp; &quot; | Lead ID: &quot; &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>formula_ContactTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;New enquiry received from existing contact: &quot; &amp; {!$Record.Email}</expression>
    </formulas>
    <formulas>
        <name>formula_MergedDescription</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!var_matchedLead.Description}), {!$Record.Description}, {!var_matchedLead.Description} &amp; &quot; [Updated &quot; &amp; TEXT(TODAY()) &amp; &quot;] &quot; &amp; {!$Record.Description})</expression>
    </formulas>
    <formulas>
        <name>formula_TodayPlusTwo</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <interviewLabel>Lead Duplicate Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - After Save - Duplicate Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Task_On_Contact_Owner</name>
        <label>Create Task on Contact Owner</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Flag_Lead_Contact_Match</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>formula_TodayPlusTwo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_ContactTaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>var_matchedContact.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_ContactTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>var_matchedContact.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>var_matchedContact.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Contact_Match</name>
        <label>Get Matching Active Contact</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contact_Match_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>var_matchedContact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>OwnerId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Lead_Match</name>
        <label>Get Matching Open Lead</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Open_Lead_Match_Decision</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Lead</object>
        <outputReference>var_matchedLead</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Product_Interest__c</queriedFields>
        <queriedFields>Target_Country__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Flag_Lead_Contact_Match</name>
        <label>Set Duplicate Flag (Contact Match)</label>
        <locationX>374</locationX>
        <locationY>480</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Duplicate_Account__c</field>
            <value>
                <elementReference>var_matchedContact.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Duplicate_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Flag_Lead_Open_Lead_Match</name>
        <label>Set Duplicate Flag (Open Lead Match)</label>
        <locationX>374</locationX>
        <locationY>960</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Duplicate_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Master_Record__c</field>
            <value>
                <elementReference>var_matchedLead.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <recordUpdates>
        <name>Merge_Into_Existing_Lead</name>
        <label>Merge Into Existing Lead</label>
        <locationX>374</locationX>
        <locationY>840</locationY>
        <connector>
            <targetReference>Flag_Lead_Open_Lead_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_matchedLead.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_MergedDescription</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_matchedContact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>var_matchedLead</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
