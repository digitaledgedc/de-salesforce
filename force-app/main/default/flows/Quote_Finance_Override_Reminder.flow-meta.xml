            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Reminder_Count</name>
        <label>Escalate or Remind?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Increment_Count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below threshold - send reminder</defaultConnectorLabel>
        <rules>
            <name>Escalate_Now</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_quote.Finance_Approval_Reminder_Count__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Count_Escalate</targetReference>
            </connector>
            <label>3+ reminders - escalate</label>
        </rules>
    </decisions>
    <description>F-COR-R: Launched from the Send Reminder to Finance quick action on a Quote. Checks the reminder count and 24-hour cooldown. If cooldown has passed: sends reminder email, increments Finance_Approval_Reminder_Count__c. After 3 reminders, escalates to regional lead email. Credit block info now read from Account directly.</description>
    <formulas>
        <name>frmEscalateBody</name>
        <dataType>String</dataType>
        <expression>&quot;A credit override request has been sent 3+ times without response. Escalating to Regional Lead.\n\nQuote: &quot; &amp; {!var_quote.Name} &amp; &quot;\nAccount: &quot; &amp; {!var_account.Name} &amp; &quot;\nBlock Reason: &quot; &amp; TEXT({!var_account.Credit_Block_Reason__c}) &amp; &quot;\nReminders sent: &quot; &amp; TEXT({!var_quote.Finance_Approval_Reminder_Count__c} + 1) &amp; &quot;\n\nEscalated by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>frmEscalateSubject</name>
        <dataType>String</dataType>
        <expression>&quot;ESCALATION: Credit Override Unactioned - &quot; &amp; {!var_account.Name}</expression>
    </formulas>
    <formulas>
        <name>frmNewCount</name>
        <dataType>Number</dataType>
        <expression>{!var_quote.Finance_Approval_Reminder_Count__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frmReminderBody</name>
        <dataType>String</dataType>
        <expression>&quot;This is reminder #&quot; &amp; TEXT({!var_quote.Finance_Approval_Reminder_Count__c} + 1) &amp; &quot; for a pending credit decision.\n\nQuote: &quot; &amp; {!var_quote.Name} &amp; &quot;\nAccount: &quot; &amp; {!var_account.Name} &amp; &quot;\nBlock Reason: &quot; &amp; TEXT({!var_account.Credit_Block_Reason__c}) &amp; &quot;\n\nReminder sent by: &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot;\n\nPlease action this in Salesforce at your earliest convenience. After 3 reminders, this will be escalated to the Regional Lead.&quot;</expression>
    </formulas>
    <formulas>
        <name>frmReminderSubject</name>
        <dataType>String</dataType>
        <expression>&quot;REMINDER: Credit Override Pending - &quot; &amp; {!var_quote.Name} &amp; &quot; (&quot; &amp; {!var_account.Name} &amp; &quot;)&quot;</expression>
    </formulas>
    <interviewLabel>Quote - Finance Override Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote - Finance Override Reminder</label>
    <processMetadataValues>
