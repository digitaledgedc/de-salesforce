    <actionCalls>
        <name>Send_Reminder_Email</name>
        <label>Send Reminder to Finance</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Screen_ReminderSent</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_ReminderSent</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>finance-approvals@digitaledge.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>frmReminderSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
