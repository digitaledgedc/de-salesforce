<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Fault_End</name>
        <label>Fault - End Gracefully</label>
        <locationX>440</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>var_faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>F-16: After Opportunity stage moves to 3-Quote, auto-creates a new Quote linked to the Opp. Fires each time stage changes to 3-Quote - supports multiple quotes per Opp. Quote_BeforeSave_AutoSetup (F-14) handles Name, Version, ExpirationDate, Target_Site, and Pricebook assignment automatically. Contract_Term_Months__c is carried from the Opp. Skips Change Order opps (Original_Order__c != null) because ChangeOrderController explicitly creates the Quote — preventing duplicate blank quotes.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmQuoteType</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Deal_Type__c},
    &quot;Change Order&quot;, &quot;Amendment&quot;,
    &quot;Churn&quot;, &quot;Termination&quot;,
    &quot;Renewal&quot;, &quot;Renewal&quot;,
    &quot;Annual Price Increase&quot;, &quot;Amendment&quot;,
    &quot;New&quot;)</expression>
    </formulas>
    <interviewLabel>Opportunity Auto Create Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - After Save - Auto Create Quote</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Quote</name>
        <label>Create New Quote</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Quote_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Term_Months__c</field>
            <value>
                <elementReference>$Record.Contract_Term_Months__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Ops_Contact__c</field>
            <value>
                <elementReference>$Record.Ops_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Order_Contact__c</field>
            <value>
                <elementReference>$Record.Order_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QuoteAccountId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quote_Type__c</field>
            <value>
                <elementReference>frmQuoteType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RDD__c</field>
            <value>
                <elementReference>$Record.GoLive_Target_Date__c</elementReference>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Quote</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>3-Quote</stringValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Original_Order__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
