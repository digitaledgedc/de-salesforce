<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Reserved_NA</name>
        <label>Set Reserved to N/A</label>
        <locationX>50</locationX>
        <locationY>492</locationY>
        <assignmentItems>
            <assignToReference>$Record.Reserved__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>N/A</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Capacity_Assignment</name>
        <label>Product Requires Capacity?</label>
        <locationX>176</locationX>
        <locationY>432</locationY>
        <defaultConnector>
            <targetReference>Set_Reserved_NA</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Capacity Required</defaultConnectorLabel>
        <rules>
            <name>Has_Capacity_Assignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Product.Capacity_Assignment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Has Capacity Assignment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_CO_QLI</name>
        <label>Is CO/Termination/NRC QLI?</label>
        <locationX>176</locationX>
        <locationY>312</locationY>
        <defaultConnector>
            <targetReference>Check_Capacity_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Normal QLI</defaultConnectorLabel>
        <rules>
            <name>outcome_CO_QLI</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Change_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DELETE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Change_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NO_CHANGE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Charge_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NRC</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Reserved_NA</targetReference>
            </connector>
            <label>CO/Termination/NRC QLI</label>
        </rules>
    </decisions>
    <description>Before-save flow on QuoteLineItem. Sets Reserved__c to N/A for: NRC items (Charge_Type__c = NRC), CO/Termination items, and products without Capacity_Assignment__c. Products with Capacity_Assignment__c and MRC charge type keep the default Not Reserved until Ops assigns inventory.</description>
    <environments>Default</environments>
    <interviewLabel>QLI Reserved Default {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QuoteLineItem Before-Save Reserved Default</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Product</name>
        <label>Get Product</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_CO_QLI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product2Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Product2</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Capacity_Assignment__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Product</targetReference>
        </connector>
        <object>QuoteLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
