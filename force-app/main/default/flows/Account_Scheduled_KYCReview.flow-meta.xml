<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Any_Overdue_Accounts</name>
        <label>Any Overdue Accounts?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Accounts - End</defaultConnectorLabel>
        <rules>
            <name>Accounts_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>col_overdueKYC</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Overdue_Accounts</targetReference>
            </connector>
            <label>Accounts Found</label>
        </rules>
    </decisions>
    <description>F-06: Runs daily at 03:00 HKT. Finds all Approved Accounts where KYC_Last_Review_Date__c is more than 365 days ago. Sets KYC_Status__c = Submitted to Finance and creates a Task on the Country Finance queue for each overdue account.</description>
    <formulas>
        <name>formula_365DaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 365</expression>
    </formulas>
    <formulas>
        <name>formula_TaskDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Last KYC review was on &quot; &amp; TEXT({!Loop_Overdue_Accounts.KYC_Last_Review_Date__c}) &amp; &quot;. Annual review is now overdue. Please initiate KYC review using the Submit for Finance Approval action on the Account.&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;ANNUAL KYC REVIEW OVERDUE - &quot; &amp; {!Loop_Overdue_Accounts.Name}</expression>
    </formulas>
    <interviewLabel>Account KYC Annual Review {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Scheduled - KYC Annual Review</label>
    <loops>
        <name>Loop_Overdue_Accounts</name>
        <label>Loop Overdue KYC Accounts</label>
        <locationX>374</locationX>
        <locationY>360</locationY>
        <collectionReference>col_overdueKYC</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Country_Finance_Queue</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_KYC_Task</name>
        <label>Create KYC Review Task</label>
        <locationX>572</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Loop_Overdue_Accounts</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>formula_TaskDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_TaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>var_countryFinanceQueue.Queue_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>Loop_Overdue_Accounts.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Country_Finance_Queue</name>
        <label>Get Country Finance Queue for Account</label>
        <locationX>572</locationX>
        <locationY>480</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_KYC_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Country_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Overdue_Accounts.Operation_Country__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Queue_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Finance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Country_Queue__mdt</object>
        <outputReference>var_countryFinanceQueue</outputReference>
        <queriedFields>Queue_Id__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Overdue_KYC_Accounts</name>
        <label>Get Accounts with Overdue KYC</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Overdue_Accounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Finance_Approval_Phase__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>KYC_Last_Review_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>formula_365DaysAgo</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>col_overdueKYC</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Operation_Country__c</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>KYC_Last_Review_Date__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_KYC_Status</name>
        <label>Set KYC Status = Submitted to Finance</label>
        <locationX>572</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Create_KYC_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Overdue_Accounts.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>KYC_Status__c</field>
            <value>
                <stringValue>Submitted to Finance</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Overdue_KYC_Accounts</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-04-08</startDate>
            <startTime>19:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>col_overdueKYC</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>var_countryFinanceQueue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Country_Queue__mdt</objectType>
    </variables>
</Flow>
